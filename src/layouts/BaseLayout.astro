---
import Nav from "../components/Nav.astro";
import NavProgress from "../components/NavProgress.astro";
import ToastContainer from "../components/ToastContainer.astro";
import SyncModal from "../components/SyncModal.astro";
import type { Locale } from "../lib/i18n/translations";
import "../styles/global.css";

interface Props {
  title: string;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { title, alternateUrls } = Astro.props;
const currentLocale = Astro.currentLocale ?? "en";
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://raw.githubusercontent.com" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#101014" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PokeForge" />
    <title>{title} · PokeForge</title>
  </head>
  <body>
    <NavProgress locale={currentLocale as Locale} />
    <Nav alternateUrls={alternateUrls} />
    <slot />
    <SyncModal />
    <ToastContainer />
    <script>
      import { refreshIcons } from "../lib/icons";
      refreshIcons();

      if ("serviceWorker" in navigator) {
        if (import.meta.env.PROD) {
          window.addEventListener("load", () => {
            navigator.serviceWorker
              .register("/sw.js")
              .then((registration) => {
                registration.update();
              })
              .catch((err) => {
                console.warn("ServiceWorker error:", err);
              });
          });
        } else {
          // En desarrollo, desregistrar Service Workers para evitar colisiones con Vite HMR y caché de dependencias
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
        }
      }
    </script>
  </body>
</html>
