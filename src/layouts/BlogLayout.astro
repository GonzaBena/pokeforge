---
import Nav from "../components/Nav.astro";
import NavProgress from "../components/NavProgress.astro";
import type { Locale } from "../lib/i18n/translations";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  pubDate?: Date;
  author?: string;
  alternateUrls?: Partial<Record<Locale, string>>;
  type?: "website" | "article";
}

const {
  title,
  description = "Guías, análisis competitivo, curiosidades y herramientas para Pokémon en PokeForge.",
  image = "/favicon.png",
  pubDate,
  author = "PokeForge Team",
  alternateUrls,
  type = "website",
} = Astro.props;

const currentLocale = Astro.currentLocale ?? "en";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const resolvedImageUrl = image.startsWith("http") ? image : new URL(image, Astro.site ?? Astro.url.origin).href;

const schemaData = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": resolvedImageUrl,
  "datePublished": pubDate ? pubDate.toISOString() : undefined,
  "author": {
    "@type": "Person",
    "name": author,
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
} : null;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#101014" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PokeForge" />

    <title>{title} · PokeForge</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} · PokeForge`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageUrl} />
    <meta property="og:site_name" content="PokeForge" />
    <meta property="og:locale" content={currentLocale === "es" ? "es_ES" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} · PokeForge`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageUrl} />

    {schemaData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
    )}
  </head>
  <body>
    <NavProgress locale={currentLocale as Locale} />
    <Nav alternateUrls={alternateUrls} variant="minimal" />
    <slot />
    <script>
      import { refreshIcons } from "../lib/icons";
      refreshIcons();

      if ("serviceWorker" in navigator) {
        if (import.meta.env.PROD) {
          window.addEventListener("load", () => {
            navigator.serviceWorker
              .register("/sw.js")
              .then((registration) => {
                registration.update();
              })
              .catch((err) => {
                console.warn("ServiceWorker error:", err);
              });
          });
        } else {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
        }
      }
    </script>
  </body>
</html>
