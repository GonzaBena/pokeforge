---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getTranslations, getLocalizedPath, type Locale } from "../lib/i18n/translations";
import { getAuthor } from "../lib/authors";
import { getGuideHierarchy, getPostUrl, getCoverImageSrc } from "../lib/guides";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
const { Content, headings } = await render(post);

// Obtener todas las entradas de este idioma para resolver relaciones de guías
const allLocalePosts = await getCollection("blog", ({ id }) =>
  id.startsWith(`${currentLocale}/`)
);
const guide = getGuideHierarchy(post, allLocalePosts, currentLocale);
const isGuideInProgress = Boolean(post.data.inProgress || guide.parentPost?.data.inProgress);

const author = getAuthor(post.data.author);
const blogPath = getLocalizedPath("/blog/", currentLocale);

// Filtrar encabezados H2 y H3 para el índice de contenidos
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = toc.length >= 2;

const formattedDate = post.data.pubDate.toLocaleDateString(
  currentLocale === "es" ? "es-ES" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }
);

const categoryName =
  t.blog.categories[post.data.category as keyof typeof t.blog.categories] ??
  post.data.category;

// Calcular la URL equivalente en el otro idioma (o fallback al listado general del blog)
const targetLocale: Locale = currentLocale === "es" ? "en" : "es";
let alternatePostUrl: string;

if (post.data.translation) {
  alternatePostUrl =
    targetLocale === "es"
      ? `/es/blog/${post.data.translation}/`
      : `/blog/${post.data.translation}/`;
} else {
  alternatePostUrl = getLocalizedPath("/blog/", targetLocale);
}

const alternateUrls: Partial<Record<Locale, string>> = {
  [currentLocale]: Astro.url.pathname,
  [targetLocale]: alternatePostUrl,
};

const coverSrc = post.data.coverImage ? getCoverImageSrc(post.data.coverImage) : null;
---

<BaseLayout title={`${post.data.title} · Blog`} alternateUrls={alternateUrls}>
  <div class="article-page">
    <div class="article-ambient-glow" aria-hidden="true"></div>

    <article class="article-container">
      {guide.isChapter ? (
        <nav class="article-nav article-nav--guide" aria-label="Navegación de guía">
          <ol class="guide-breadcrumbs">
            <li>
              <a href={blogPath} class="guide-breadcrumb-link" data-astro-prefetch>
                <i data-lucide="newspaper"></i>
                <span>{t.nav.blog}</span>
              </a>
            </li>
            <li class="guide-breadcrumb-separator" aria-hidden="true">
              <i data-lucide="chevron-right"></i>
            </li>
            {guide.parentPost && guide.parentUrl && (
              <li>
                <a href={guide.parentUrl} class="guide-breadcrumb-link" data-astro-prefetch>
                  <i data-lucide="book-open"></i>
                  <span>{guide.parentPost.data.title}</span>
                </a>
              </li>
              <li class="guide-breadcrumb-separator" aria-hidden="true">
                <i data-lucide="chevron-right"></i>
              </li>
            )}
            <li class="guide-breadcrumb-current" aria-current="page">
              <span>{t.blog.guideChapter} {guide.currentNumber}</span>
            </li>
          </ol>

          {guide.chapters.length > 1 && (
            <div class="guide-quick-nav">
              <details class="guide-quick-dropdown">
                <summary class="guide-quick-btn">
                  <i data-lucide="list-ordered"></i>
                  <span>{t.blog.guideQuickNav} ({guide.currentNumber}/{guide.totalChapters})</span>
                  <i data-lucide="chevron-down" class="guide-quick-chevron"></i>
                </summary>
                <div class="guide-quick-menu">
                  <div class="guide-quick-menu__header">
                    <span class="guide-quick-menu__title">
                      {guide.parentPost?.data.title ?? t.blog.guideIndexTitle}
                    </span>
                  </div>
                  <ul class="guide-quick-menu__list">
                    {guide.chapters.map((ch, idx) => {
                      const chOrder = ch.data.order ?? (idx + 1);
                      const isCurrent = ch.id === post.id;
                      return (
                        <li>
                          <a
                            href={getPostUrl(ch.id, currentLocale)}
                            class={`guide-quick-item ${isCurrent ? "active" : ""}`}
                            data-astro-prefetch
                          >
                            <span class="guide-quick-item__num">{chOrder}</span>
                            <span class="guide-quick-item__title">{ch.data.title}</span>
                            {isCurrent && (
                              <i data-lucide="check" class="guide-quick-item__check"></i>
                            )}
                          </a>
                        </li>
                      );
                    })}
                    {guide.plannedChapters.map((pch, idx) => {
                      const pchOrder = pch.order ?? (guide.chapters.length + idx + 1);
                      return (
                        <li>
                          <div
                            class="guide-quick-item guide-quick-item--planned"
                            title={pch.description ?? t.blog.guideChapterPlannedDesc}
                          >
                            <span class="guide-quick-item__num">{pchOrder}</span>
                            <span class="guide-quick-item__title">{pch.title}</span>
                            <span class="guide-quick-item__badge">{t.blog.guideChapterPlanned}</span>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </details>
            </div>
          )}
        </nav>
      ) : (
        <nav class="article-nav" aria-label="Volver">
          <a href={blogPath} class="article-back-btn" data-astro-prefetch>
            <i data-lucide="chevron-left"></i>
            <span>{t.blog.backToBlog}</span>
          </a>
        </nav>
      )}

      <header class="article-header" id="article-top">
        <div class="article-header__meta">
          <span class={`blog-badge blog-badge--${post.data.category}`}>
            {categoryName}
          </span>
          {guide.isChapter && (
            <span class="guide-chapter-pill">
              <i data-lucide="map-pin"></i>
              {t.blog.guideChapterProgress
                .replace("{current}", String(guide.currentNumber))
                .replace("{total}", String(guide.totalChapters))}
            </span>
          )}
          {guide.isHub && (
            <span class="blog-featured-pill blog-featured-pill--guide">
              <i data-lucide="book-open"></i>
              {guide.plannedChapters.length > 0
                ? `${t.blog.guideHubBadge} (${guide.totalChapters}/${guide.totalChapters + guide.plannedChapters.length} ${t.blog.guideAllChapters.toLowerCase()})`
                : `${t.blog.guideHubBadge} (${guide.totalChapters} ${t.blog.guideAllChapters.toLowerCase()})`}
            </span>
          )}
          {post.data.inProgress && (
            <span class="blog-status-pill blog-status-pill--wip">
              <i data-lucide="clock"></i>
              <span>{t.blog.inProgressBadge}</span>
            </span>
          )}
          <div class="article-header__author-chip">
            <img
              src={author.avatar}
              alt={author.name}
              class="article-header__author-avatar"
              loading="eager"
            />
            <span>{author.name}</span>
          </div>
          <span class="article-date">
            <i data-lucide="calendar"></i>
            {formattedDate}
          </span>
          {post.data.readingTime && (
            <span class="blog-read-time">
              <i data-lucide="clock"></i>
              {post.data.readingTime}
            </span>
          )}
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-subtitle">{post.data.description}</p>

        {coverSrc && (
          <div class={`article-cover ${post.data.coverImageFit === "cover" ? "article-cover--cover" : ""}`}>
            <img
              src={coverSrc}
              alt={post.data.title}
              loading="eager"
            />
          </div>
        )}
      </header>

      {hasToc && (
        <details class="article-toc-mobile">
          <summary class="article-toc-mobile__summary">
            <span class="article-toc-mobile__title">
              <i data-lucide="list"></i>
              <span>{t.blog.tocMobileTitle}</span>
            </span>
            <span class="article-toc-mobile__count">{toc.length}</span>
            <i data-lucide="chevron-down" class="article-toc-mobile__chevron"></i>
          </summary>
          <nav class="article-toc-mobile__nav">
            {toc.map((item) => (
              <a
                href={`#${item.slug}`}
                class={`article-toc-link depth-${item.depth}`}
              >
                {item.text}
              </a>
            ))}
          </nav>
        </details>
      )}

      <!-- Layout: Contenido principal + Índice lateral Sticky en desktop -->
      <div class={`article-layout ${hasToc ? "has-toc" : ""}`}>
        <div class="article-main">
          {post.data.inProgress && (
            <aside class="article-wip-banner" aria-label={t.blog.inProgressNoticeTitle}>
              <div class="article-wip-banner__icon">
                <i data-lucide="clock"></i>
              </div>
              <div class="article-wip-banner__body">
                <strong class="article-wip-banner__title">{t.blog.inProgressNoticeTitle}</strong>
                <p class="article-wip-banner__desc">{t.blog.inProgressNoticeDesc}</p>
              </div>
            </aside>
          )}

          <div class="article-body">
            <Content />
          </div>

          {guide.isHub && (guide.chapters.length > 0 || guide.plannedChapters.length > 0) && (
            <section class="guide-hub-section" id="capitulos">
              <div class="guide-hub-section__header">
                <div class="guide-hub-section__badge">
                  <i data-lucide="compass"></i>
                  <span>{t.blog.guideIndexTitle}</span>
                </div>
                <h2 class="guide-hub-section__title">{t.blog.guideIndexTitle}</h2>
                <p class="guide-hub-section__subtitle">{t.blog.guideIndexSubtitle}</p>
              </div>

              <div class="guide-chapters-grid">
                {guide.chapters.map((ch, idx) => {
                  const chOrder = ch.data.order ?? (idx + 1);
                  const chUrl = getPostUrl(ch.id, currentLocale);
                  return (
                    <a href={chUrl} class="guide-chapter-card" data-astro-prefetch>
                      <div class="guide-chapter-card__number">
                        <span>{String(chOrder).padStart(2, "0")}</span>
                      </div>
                      <div class="guide-chapter-card__content">
                        <div class="guide-chapter-card__meta">
                          <span class="guide-chapter-card__tag">
                            {t.blog.guideChapter} {chOrder}
                          </span>
                          {ch.data.readingTime && (
                            <span class="guide-chapter-card__time">
                              <i data-lucide="clock"></i>
                              {ch.data.readingTime}
                            </span>
                          )}
                        </div>
                        <h3 class="guide-chapter-card__title">{ch.data.title}</h3>
                        <p class="guide-chapter-card__desc">{ch.data.description}</p>
                      </div>
                      <div class="guide-chapter-card__action">
                        <i data-lucide="arrow-right"></i>
                      </div>
                    </a>
                  );
                })}

                {guide.plannedChapters.map((pch, idx) => {
                  const pchOrder = pch.order ?? (guide.chapters.length + idx + 1);
                  return (
                    <div class="guide-chapter-card guide-chapter-card--planned" aria-disabled="true">
                      <div class="guide-chapter-card__number">
                        <span>{String(pchOrder).padStart(2, "0")}</span>
                      </div>
                      <div class="guide-chapter-card__content">
                        <div class="guide-chapter-card__meta">
                          <span class="guide-chapter-card__tag">
                            {t.blog.guideChapter} {pchOrder}
                          </span>
                          <span class="guide-chapter-card__status-pill">
                            <i data-lucide="clock"></i>
                            {t.blog.guideChapterPlanned}
                          </span>
                        </div>
                        <h3 class="guide-chapter-card__title">{pch.title}</h3>
                        <p class="guide-chapter-card__desc">
                          {pch.description ?? t.blog.guideChapterPlannedDesc}
                        </p>
                      </div>
                      <div class="guide-chapter-card__action">
                        <i data-lucide="lock"></i>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          {guide.isChapter && (
            <nav class="guide-stepper" aria-label="Navegación entre capítulos">
              <div class="guide-stepper__col guide-stepper__col--prev">
                {guide.prevChapter && guide.prevUrl ? (
                  <a
                    href={guide.prevUrl}
                    class="guide-stepper__card guide-stepper__card--prev"
                    data-astro-prefetch
                  >
                    <span class="guide-stepper__sub">
                      <i data-lucide="arrow-left"></i>
                      <span>{t.blog.guidePrevChapter}</span>
                    </span>
                    <span class="guide-stepper__title">{guide.prevChapter.data.title}</span>
                  </a>
                ) : guide.parentPost && guide.parentUrl ? (
                  <a
                    href={guide.parentUrl}
                    class="guide-stepper__card guide-stepper__card--overview"
                    data-astro-prefetch
                  >
                    <span class="guide-stepper__sub">
                      <i data-lucide="arrow-left"></i>
                      <span>{t.blog.guideBackToHub}</span>
                    </span>
                    <span class="guide-stepper__title">{guide.parentPost.data.title}</span>
                  </a>
                ) : null}
              </div>

              {guide.parentPost && guide.parentUrl && (
                <div class="guide-stepper__col guide-stepper__col--center">
                  <a
                    href={guide.parentUrl}
                    class="guide-stepper__center-btn"
                    title={t.blog.guideBackToHub}
                    data-astro-prefetch
                  >
                    <i data-lucide="home"></i>
                    <span>{t.blog.guideIndexShort}</span>
                  </a>
                </div>
              )}

              <div class="guide-stepper__col guide-stepper__col--next">
                {guide.nextChapter && guide.nextUrl ? (
                  <a
                    href={guide.nextUrl}
                    class="guide-stepper__card guide-stepper__card--next"
                    data-astro-prefetch
                  >
                    <span class="guide-stepper__sub">
                      <span>{t.blog.guideNextChapter}</span>
                      <i data-lucide="arrow-right"></i>
                    </span>
                    <span class="guide-stepper__title">{guide.nextChapter.data.title}</span>
                  </a>
                ) : isGuideInProgress ? (
                  <div class="guide-stepper__card guide-stepper__card--next guide-stepper__card--wip">
                    <span class="guide-stepper__sub">
                      <i data-lucide="clock"></i>
                      <span>{t.blog.guideNextChapterPending}</span>
                    </span>
                    <span class="guide-stepper__title">
                      {guide.nextPlannedChapter
                        ? guide.nextPlannedChapter.title
                        : t.blog.guideNextChapterPendingDesc}
                    </span>
                  </div>
                ) : guide.parentPost && guide.parentUrl ? (
                  <a
                    href={guide.parentUrl}
                    class="guide-stepper__card guide-stepper__card--next guide-stepper__card--overview"
                    data-astro-prefetch
                  >
                    <span class="guide-stepper__sub">
                      <span>{t.blog.guideBackToHub}</span>
                      <i data-lucide="arrow-right"></i>
                    </span>
                    <span class="guide-stepper__title">{guide.parentPost.data.title}</span>
                  </a>
                ) : (
                  <div class="guide-stepper__card guide-stepper__card--end">
                    <span class="guide-stepper__sub">
                      <i data-lucide="check-circle-2"></i>
                      <span>{currentLocale === "es" ? "Fin de la guía" : "End of guide"}</span>
                    </span>
                    <span class="guide-stepper__title">{t.blog.moreArticles}</span>
                  </div>
                )}
              </div>
            </nav>
          )}

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="article-tags">
              {post.data.tags.map((tag) => (
                <a
                  href={`${blogPath}?tag=${encodeURIComponent(tag)}`}
                  class="article-tag"
                  data-astro-prefetch
                  title={`${t.blog.filteringByTag} #${tag}`}
                >
                  <i data-lucide="tag"></i>
                  <span>#{tag}</span>
                </a>
              ))}
            </div>
          )}

          <footer class="article-footer-box">
            <div class="article-footer-author">
              <img
                src={author.avatar}
                alt={author.name}
                class="article-author-avatar"
                loading="lazy"
              />
              <div class="article-author-info">
                <div class="article-author-name">{author.name}</div>
                <div class="article-author-sub">{author.role[currentLocale] ?? author.role.es}</div>
                {author.bio && (
                  <p class="article-author-bio">{author.bio[currentLocale] ?? author.bio.es}</p>
                )}
              </div>
            </div>

            <a href={blogPath} class="article-back-btn" data-astro-prefetch>
              <span>{t.blog.moreArticles}</span>
              <i data-lucide="arrow-right"></i>
            </a>
          </footer>
        </div>

        {hasToc && (
          <aside class="article-toc-aside" aria-label={t.blog.tocTitle}>
            <div class="article-toc-sticky">
              <div class="article-toc-header">
                <i data-lucide="list"></i>
                <span>{t.blog.tocTitle}</span>
              </div>
              <nav class="article-toc-nav" data-article-toc>
                {toc.map((item) => (
                  <a
                    href={`#${item.slug}`}
                    class={`article-toc-link depth-${item.depth}`}
                    data-toc-slug={item.slug}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>

              <div class="article-toc-actions">
                <button type="button" class="article-toc-action-btn" id="toc-back-to-top">
                  <i data-lucide="arrow-up"></i>
                  <span>{t.blog.backToTop}</span>
                </button>
              </div>
            </div>
          </aside>
        )}
      </div>
    </article>

    <!-- Lightbox Modal para ampliar fotos, mapas y capturas de artículos -->
    <dialog
      id="article-lightbox"
      class="article-lightbox"
      closedby="any"
      aria-label={currentLocale === "es" ? "Vista ampliada de imagen" : "Enlarged image preview"}
    >
      <div class="article-lightbox__dialog">
        <button
          type="button"
          class="article-lightbox__close"
          aria-label={currentLocale === "es" ? "Cerrar imagen (Esc)" : "Close image (Esc)"}
          data-lightbox-close
        >
          <i data-lucide="x"></i>
        </button>
        <div class="article-lightbox__media">
          <img
            id="article-lightbox-img"
            class="article-lightbox__img"
            src=""
            alt=""
          />
        </div>
        <div class="article-lightbox__footer">
          <p id="article-lightbox-caption" class="article-lightbox__caption"></p>
          <span class="article-lightbox__hint">
            <i data-lucide="info"></i>
            <span>{currentLocale === "es" ? "Haz clic fuera o presiona Esc para cerrar" : "Click outside or press Esc to close"}</span>
          </span>
        </div>
      </div>
    </dialog>
  </div>

  <script>
    import { refreshIcons } from "../lib/icons";

    function setupTocScrollspy() {
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
        "[data-article-toc] a[data-toc-slug]"
      );
      if (tocLinks.length === 0) return;

      const headingMap = new Map<string, HTMLElement>();
      const slugs: string[] = [];

      tocLinks.forEach((link) => {
        const slug = link.dataset.tocSlug;
        if (!slug) return;
        const target = document.getElementById(slug);
        if (target) {
          headingMap.set(slug, target);
          slugs.push(slug);
        }
      });

      if (slugs.length === 0) return;

      function updateActiveLink(activeSlug: string) {
        tocLinks.forEach((link) => {
          if (link.dataset.tocSlug === activeSlug) {
            link.classList.add("active");
            link.scrollIntoView({ block: "nearest", behavior: "smooth" });
          } else {
            link.classList.remove("active");
          }
        });
      }

      // Marcar el primer link activo por defecto
      updateActiveLink(slugs[0]);

      // Suave scroll al hacer click en enlaces del índice
      tocLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const slug = link.dataset.tocSlug;
          if (!slug) return;
          const target = document.getElementById(slug);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", `#${slug}`);
            updateActiveLink(slug);
          }
        });
      });

      // Botón volver arriba
      const backToTopBtn = document.getElementById("toc-back-to-top");
      if (backToTopBtn) {
        backToTopBtn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // Intersection Observer para resaltar la sección activa
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              updateActiveLink(entry.target.id);
            }
          });
        },
        {
          rootMargin: "0px 0px -70% 0px",
          threshold: 0.1,
        }
      );

      headingMap.forEach((el) => observer.observe(el));

      // Si el usuario llega al fondo del artículo, activar el último encabezado
      function handleScroll() {
        const scrollBottom = window.innerHeight + window.scrollY;
        const pageHeight = document.documentElement.scrollHeight;
        if (pageHeight - scrollBottom < 120 && slugs.length > 0) {
          updateActiveLink(slugs[slugs.length - 1]);
        }
      }
      window.addEventListener("scroll", handleScroll, { passive: true });

      // En móviles, cerrar el desplegable al tocar un enlace
      const mobileDetails = document.querySelector<HTMLDetailsElement>(".article-toc-mobile");
      if (mobileDetails) {
        mobileDetails.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => {
            mobileDetails.open = false;
          });
        });
      }
    }

    function setupGuideInteractions() {
      document.addEventListener("click", (e) => {
        const dropdown = document.querySelector<HTMLDetailsElement>(".guide-quick-dropdown[open]");
        if (dropdown && !dropdown.contains(e.target as Node)) {
          dropdown.open = false;
        }
      });
    }

    function setupArticleLightbox() {
      const lightbox = document.getElementById("article-lightbox") as HTMLDialogElement | null;
      if (!lightbox) return;

      const lightboxImg = document.getElementById("article-lightbox-img") as HTMLImageElement | null;
      const captionEl = document.getElementById("article-lightbox-caption");
      const closeBtn = lightbox.querySelector("[data-lightbox-close]");

      if (!lightboxImg || !captionEl) return;

      // Seleccionar todas las imágenes del cuerpo del artículo y la portada
      const images = document.querySelectorAll<HTMLImageElement>(
        ".article-body img:not([data-no-zoom]), .article-cover img"
      );

      images.forEach((img) => {
        if (img.dataset.hasLightbox === "true") return;
        img.dataset.hasLightbox = "true";

        img.addEventListener("click", (e) => {
          // Si la imagen está dentro de un enlace que navega a otra página, no bloquear la navegación
          const parentLink = img.closest("a");
          if (parentLink && parentLink.getAttribute("href") && !parentLink.getAttribute("href")?.startsWith("#")) {
            return;
          }
          e.preventDefault();

          const src = img.currentSrc || img.src;
          if (!src) return;

          const cleanAlt = (img.alt || "")
            .replace(/(\|([a-z0-9-]+)\s*)+$/i, "")
            .trim();
          lightboxImg.src = src;
          lightboxImg.alt = cleanAlt;

          // Extraer descripción o pie de foto
          let caption = "";
          const parentFigure = img.closest("figure");
          const figcaption = parentFigure?.querySelector("figcaption");

          if (figcaption && figcaption.textContent) {
            caption = figcaption.textContent.trim();
          } else {
            // 1. Buscar si hay un <em> inmediatamente adyacente dentro del mismo contenedor
            let adjacentEm: HTMLElement | null = null;
            let sibling = img.nextElementSibling;
            while (sibling && sibling.tagName === "BR") {
              sibling = sibling.nextElementSibling;
            }
            if (sibling && sibling.tagName === "EM") {
              adjacentEm = sibling as HTMLElement;
            }

            const parentP = img.closest("p");
            const samePEm = parentP?.querySelector("em");
            const nextElem = parentP?.nextElementSibling;
            const nextEm = nextElem?.querySelector("em");

            if (adjacentEm && adjacentEm.textContent) {
              caption = adjacentEm.textContent.trim();
            } else if (samePEm && samePEm.textContent && parentP && parentP.querySelectorAll("img").length === 1) {
              caption = samePEm.textContent.trim();
            } else if (nextEm && nextEm.textContent && nextElem?.children.length === 1) {
              caption = nextEm.textContent.trim();
            } else if (cleanAlt) {
              caption = cleanAlt;
            }
          }

          captionEl.textContent = caption;

          // Si es un sprite pixel-art, renderizar con pixelated
          const isPixelated =
            img.naturalWidth <= 128 ||
            img.classList.contains("starter-card__sprite") ||
            img.classList.contains("sprite") ||
            /\|sprite/i.test(img.alt || "") ||
            window.getComputedStyle(img).imageRendering === "pixelated";

          if (isPixelated) {
            lightboxImg.classList.add("is-pixelated");
          } else {
            lightboxImg.classList.remove("is-pixelated");
          }

          document.body.style.overflow = "hidden";
          lightbox.showModal();
          refreshIcons();
        });
      });

      function closeLightbox() {
        if (lightbox && lightbox.open) {
          lightbox.close();
          document.body.style.overflow = "";
        }
      }

      closeBtn?.addEventListener("click", closeLightbox);

      lightbox.addEventListener("click", (e) => {
        if (
          e.target === lightbox ||
          (e.target as HTMLElement).classList.contains("article-lightbox__dialog") ||
          (e.target as HTMLElement).classList.contains("article-lightbox__media")
        ) {
          closeLightbox();
        }
      });

      lightbox.addEventListener("close", () => {
        document.body.style.overflow = "";
        lightboxImg.src = "";
      });
    }

    function setupArticleTables() {
      document.querySelectorAll<HTMLTableElement>(".article-body table").forEach((table) => {
        if (table.parentElement?.classList.contains("table-wrapper")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "table-wrapper";
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
    }

    function setupRivalStarterSelectors() {
      const selectors = document.querySelectorAll<HTMLElement>(".rival-starter-selector");
      const slots = document.querySelectorAll<HTMLElement>(".rival-slot-container");
      if (!selectors.length && !slots.length) return;

      const STORAGE_KEY = "pokeforge_player_starter";
      let savedStarter = "bulbasaur";
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored && ["bulbasaur", "charmander", "squirtle"].includes(stored)) {
          savedStarter = stored;
        }
      } catch (e) {
        // En caso de que localStorage no esté disponible
      }

      function setActiveStarter(starterName: string) {
        // 1. Actualizar botones en todos los selectores de la página
        selectors.forEach((sel) => {
          sel.querySelectorAll<HTMLButtonElement>(".rival-starter-selector__btn").forEach((btn) => {
            const isMatch = btn.dataset.starter === starterName;
            btn.classList.toggle("is-active", isMatch);
            btn.setAttribute("aria-pressed", isMatch ? "true" : "false");
          });
        });

        // 2. Actualizar tarjetas en todos los slots de rival
        slots.forEach((slot) => {
          slot.querySelectorAll<HTMLElement>(".starter-card").forEach((card) => {
            const isMatch = card.dataset.forStarter === starterName;
            card.classList.toggle("is-active", isMatch);
          });
        });

        // 3. Guardar en almacenamiento local
        try {
          localStorage.setItem(STORAGE_KEY, starterName);
        } catch (e) {}
      }

      // Asignar eventos a los botones
      selectors.forEach((sel) => {
        sel.querySelectorAll<HTMLButtonElement>(".rival-starter-selector__btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const starter = btn.dataset.starter;
            if (starter) {
              setActiveStarter(starter);
            }
          });
        });
      });

      // Aplicar estado inicial
      setActiveStarter(savedStarter);
    }

    function setupArticleChecklists() {
      const taskItems = document.querySelectorAll<HTMLLIElement>(
        ".article-body li.task-list-item, .article-body ul.contains-task-list li"
      );
      if (!taskItems.length) return;

      const storageKey = `pokeforge_checklist_${window.location.pathname.replace(/\/$/, "")}`;
      let savedData: Record<string, boolean> = {};
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored) savedData = JSON.parse(stored);
      } catch (e) {}

      taskItems.forEach((item, index) => {
        const checkboxEl = item.querySelector<HTMLInputElement>('input[type="checkbox"]');
        if (!checkboxEl) return;
        const targetCheckbox = checkboxEl;

        targetCheckbox.removeAttribute("disabled");
        targetCheckbox.disabled = false;

        const textSnippet = (item.textContent || "").trim().slice(0, 35).replace(/\s+/g, "_");
        const itemKey = `item_${index}_${textSnippet}`;

        if (savedData[itemKey] !== undefined) {
          targetCheckbox.checked = Boolean(savedData[itemKey]);
        }
        item.classList.toggle("is-checked", targetCheckbox.checked);

        function saveCheck(isChecked: boolean) {
          targetCheckbox.checked = isChecked;
          item.classList.toggle("is-checked", isChecked);
          savedData[itemKey] = isChecked;
          try {
            localStorage.setItem(storageKey, JSON.stringify(savedData));
          } catch (e) {}
        }

        if ((item as any)._hasChecklistInit) return;
        (item as any)._hasChecklistInit = true;

        targetCheckbox.addEventListener("change", (e) => {
          e.stopPropagation();
          saveCheck(targetCheckbox.checked);
        });

        item.addEventListener("click", (e) => {
          if (e.target === targetCheckbox) return;
          if ((e.target as HTMLElement).closest("a")) return;
          saveCheck(!targetCheckbox.checked);
        });
      });
    }

    setupTocScrollspy();
    setupGuideInteractions();
    setupArticleLightbox();
    setupArticleTables();
    setupRivalStarterSelectors();
    setupArticleChecklists();
    document.addEventListener("astro:page-load", setupTocScrollspy);
    document.addEventListener("astro:page-load", setupGuideInteractions);
    document.addEventListener("astro:page-load", setupArticleLightbox);
    document.addEventListener("astro:page-load", setupArticleTables);
    document.addEventListener("astro:page-load", setupRivalStarterSelectors);
    document.addEventListener("astro:page-load", setupArticleChecklists);
  </script>
</BaseLayout>
