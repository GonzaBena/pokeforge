---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTranslations, getLocalizedPath, type Locale } from "../lib/i18n/translations";

const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
const pokedexHref = getLocalizedPath("/pokedex/", currentLocale);
const equipoHref = getLocalizedPath("/equipo/", currentLocale);
---

<BaseLayout title={currentLocale === "es" ? "Inicio" : "Home"}>
  <div class="hero-container">
    <div class="hero-ambient-glow" aria-hidden="true"></div>
    <section class="hero">
      <div class="hero__badge">
        <i data-lucide="sparkles"></i>
        <span>{t.home.badge}</span>
      </div>

      <h1 class="hero__title">
        {t.home.titlePrefix}<span class="hero__title-accent">{t.home.titleAccent}</span>{t.home.titleSuffix}
      </h1>

      <p class="hero__subtitle">
        {t.home.subtitle}
      </p>

      <div class="hero__actions">
        <a class="hero__card hero__card--pokedex" href={pokedexHref} data-astro-prefetch>
          <div class="hero__card-icon">
            <i data-lucide="book-open"></i>
          </div>
          <div class="hero__card-body">
            <strong>{t.home.explorePokedex}</strong>
            <span>{t.home.pokedexDesc}</span>
          </div>
          <i data-lucide="arrow-right" class="hero__card-arrow"></i>
        </a>

        <a class="hero__card hero__card--equipo" href={equipoHref} data-astro-prefetch>
          <div class="hero__card-icon">
            <i data-lucide="swords"></i>
          </div>
          <div class="hero__card-body">
            <strong>{t.home.buildTeam}</strong>
            <span>{t.home.teamDesc}</span>
          </div>
          <i data-lucide="arrow-right" class="hero__card-arrow"></i>
        </a>
      </div>

      <div class="hero__features">
        <div class="hero__feature">
          <i data-lucide="shield-check"></i>
          <div>
            <h4>{t.home.typeAnalysis}</h4>
            <p>{t.home.typeAnalysisDesc}</p>
          </div>
        </div>
        <div class="hero__feature">
          <i data-lucide="smartphone"></i>
          <div>
            <h4>{t.home.offlineMode}</h4>
            <p>{t.home.offlineModeDesc}</p>
          </div>
        </div>
        <div class="hero__feature">
          <i data-lucide="gamepad-2"></i>
          <div>
            <h4>{t.home.gameFilters}</h4>
            <p>{t.home.gameFiltersDesc}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
