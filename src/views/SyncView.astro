---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTranslations, getLocalizedPath, type Locale } from "../lib/i18n/translations";

const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
const pokedexHref = getLocalizedPath("/pokedex/", currentLocale);
const homeHref = getLocalizedPath("/", currentLocale);
const teamHref = getLocalizedPath("/equipo/", currentLocale);
---

<BaseLayout title={t.sync.title}>
  <main class="page sync-page" data-team-href={teamHref}>
    <div class="sync-card" data-sync-card>
      <!-- Loading state -->
      <div class="sync-card__loading" data-sync-state="loading">
        <i data-lucide="loader-2" class="spin"></i>
        <p>{t.sync.loading}</p>
      </div>

      <!-- No data / Guide state -->
      <div class="sync-card__empty" data-sync-state="empty" hidden>
        <div class="sync-card__icon-badge">
          <i data-lucide="smartphone"></i>
        </div>
        <h1 class="sync-card__title">{t.sync.heroTitle}</h1>
        <p class="sync-card__description">
          {t.sync.heroDesc}
        </p>
        <ol class="sync-steps">
          <li>
            <span class="sync-step-number">1</span>
            <div>{t.sync.step1}</div>
          </li>
          <li>
            <span class="sync-step-number">2</span>
            <div>{t.sync.step2}</div>
          </li>
          <li>
            <span class="sync-step-number">3</span>
            <div>{t.sync.step3}</div>
          </li>
        </ol>
        <div class="sync-card__actions">
          <a href={pokedexHref} class="btn btn--primary" data-astro-prefetch>
            <i data-lucide="book-open"></i>
            <span>{t.sync.goToPokedex}</span>
          </a>
          <button type="button" class="btn btn--secondary" data-sync-open>
            <i data-lucide="qr-code"></i>
            <span>{t.sync.generateQrHere}</span>
          </button>
        </div>
      </div>

      <!-- Ready to Sync state -->
      <div class="sync-card__ready" data-sync-state="ready" hidden>
        <div class="sync-card__icon-badge sync-card__icon-badge--success">
          <i data-lucide="sparkles"></i>
        </div>
        <h1 class="sync-card__title">{t.sync.readyTitle}</h1>
        <p class="sync-card__subtitle">
          {t.sync.readySubtitle}
        </p>

        <!-- Preview recibido -->
        <div class="sync-preview">
          <div class="sync-preview__section">
            <h3>{t.sync.incomingTeam}</h3>
            <div class="sync-preview__team-slots" data-preview-team>
              <!-- Rellenado dinámicamente con sprites -->
            </div>
          </div>

          <div class="sync-preview__comparison">
            <div class="sync-compare-box">
              <span class="sync-compare-box__label">{t.sync.incomingCaptures}</span>
              <strong class="sync-compare-box__value" data-incoming-captures>0</strong>
            </div>
            <div class="sync-compare-box">
              <span class="sync-compare-box__label">{t.sync.currentCaptures}</span>
              <strong class="sync-compare-box__value" data-current-captures>0</strong>
            </div>
          </div>
        </div>

        <!-- Opciones de sincronización -->
        <div class="sync-options">
          <label class="sync-option">
            <input type="radio" name="syncMode" value="merge" checked />
            <div class="sync-option__content">
              <strong>{t.sync.mergeTitle}</strong>
              <span>{t.sync.mergeDesc}</span>
            </div>
          </label>
          <label class="sync-option">
            <input type="radio" name="syncMode" value="replace" />
            <div class="sync-option__content">
              <strong>{t.sync.replaceTitle}</strong>
              <span>{t.sync.replaceDesc}</span>
            </div>
          </label>
        </div>

        <div class="sync-card__actions">
          <button type="button" class="btn btn--primary btn--lg" data-confirm-sync>
            <i data-lucide="check"></i>
            <span>{t.sync.confirmSave}</span>
          </button>
          <a href={homeHref} class="btn btn--ghost" data-astro-prefetch>{t.sync.cancel}</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { parseSyncFromHash, applySyncPayload, decodeCapturedIds, type SyncPayload } from "../lib/sync";
  import { getCapturedIds } from "../lib/storage";
  import { toast } from "../lib/toast";
  import { refreshIcons } from "../lib/icons";
  import { getCurrentLocale, getTranslations } from "../lib/i18n/translations";

  async function initSyncPage() {
    const card = document.querySelector<HTMLDivElement>("[data-sync-card]");
    if (!card) return;

    const page = document.querySelector<HTMLElement>(".sync-page");
    const teamHref = page?.dataset.teamHref || "/equipo/";

    const loadingState = card.querySelector<HTMLDivElement>('[data-sync-state="loading"]');
    const emptyState = card.querySelector<HTMLDivElement>('[data-sync-state="empty"]');
    const readyState = card.querySelector<HTMLDivElement>('[data-sync-state="ready"]');

    const previewTeam = card.querySelector<HTMLDivElement>("[data-preview-team]");
    const incomingCapturesEl = card.querySelector<HTMLElement>("[data-incoming-captures]");
    const currentCapturesEl = card.querySelector<HTMLElement>("[data-current-captures]");
    const confirmBtn = card.querySelector<HTMLButtonElement>("[data-confirm-sync]");

    let currentPayload: SyncPayload | null = null;

    try {
      currentPayload = await parseSyncFromHash();
    } catch (err) {
      console.error("Error parsing hash:", err);
    }

    if (loadingState) loadingState.hidden = true;

    if (!currentPayload) {
      if (emptyState) emptyState.hidden = false;
      refreshIcons();
      return;
    }

    // Datos válidos detectados
    if (readyState) readyState.hidden = false;

    const incomingCaptures = decodeCapturedIds(currentPayload.capturedBitset);
    const localCaptures = getCapturedIds();

    if (incomingCapturesEl) incomingCapturesEl.textContent = String(incomingCaptures.size);
    if (currentCapturesEl) currentCapturesEl.textContent = String(localCaptures.size);

    // Render team preview
    if (previewTeam) {
      previewTeam.innerHTML = "";
      const slots = currentPayload.team?.slots || [];
      for (const slot of slots) {
        const slotEl = document.createElement("div");
        slotEl.className = "sync-team-preview-slot";
        if (slot.pokemonId) {
          slotEl.innerHTML = `
            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${slot.pokemonId}.png" alt="Pokémon #${slot.pokemonId}" loading="lazy" />
          `;
        } else {
          slotEl.innerHTML = `<span class="sync-empty-slot">·</span>`;
        }
        previewTeam.appendChild(slotEl);
      }
    }

    refreshIcons();

    confirmBtn?.addEventListener("click", () => {
      if (!currentPayload) return;
      const selectedMode = (card.querySelector<HTMLInputElement>('input[name="syncMode"]:checked')?.value || "merge") as "merge" | "replace";

      const result = applySyncPayload(currentPayload, selectedMode);
      const t = getTranslations(getCurrentLocale());
      toast.success(t.sync.successToast.replace("{total}", String(result.totalCaptures)));

      // Limpiar hash de la URL
      if (window.history.replaceState) {
        window.history.replaceState(null, "", window.location.pathname);
      }

      setTimeout(() => {
        window.location.href = teamHref;
      }, 800);
    });
  }

  initSyncPage();
  document.addEventListener("astro:after-swap", initSyncPage);
</script>
