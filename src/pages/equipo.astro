---
import BaseLayout from "../layouts/BaseLayout.astro";
import StrengthsWeaknessesPanel from "../components/StrengthsWeaknessesPanel.astro";
import PokemonDetailModal from "../components/PokemonDetailModal.astro";
---

<BaseLayout title="Equipo">
  <div class="page">
    <div class="page__header">
      <div>
        <h1 class="page__title"><i data-lucide="users"></i> Armar equipo</h1>
        <p class="page__subtitle">Completa tu equipo de 5 Pokémon filtrando por generación, tipo y movimientos.</p>
      </div>
    </div>

    <div class="team-layout">
      <div class="team-slots" data-team-slots></div>
      <StrengthsWeaknessesPanel />
    </div>
  </div>

  <div class="modal-overlay" data-picker-overlay hidden>
    <div class="modal-panel picker-modal-panel">
      <div class="modal-panel__header">
        <div class="picker-panel__header-info">
          <h2><i data-lucide="sparkles"></i> Elegir Pokémon</h2>
          <span class="picker-panel__count" data-picker-count></span>
        </div>
        <button class="modal-panel__close" type="button" data-picker-close aria-label="Cerrar modal">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="picker-panel__filters">
        <div class="picker-panel__inputs-row">
          <div class="picker-input-wrap">
            <i data-lucide="search" class="picker-input-icon"></i>
            <input class="picker-input" type="search" placeholder="Buscar por nombre o #..." data-picker-search />
          </div>
          <div class="picker-input-wrap">
            <i data-lucide="swords" class="picker-input-icon"></i>
            <input
              class="picker-input"
              type="text"
              list="picker-move-options"
              placeholder="Filtrar por movimiento..."
              data-picker-move-filter
            />
            <datalist id="picker-move-options" data-picker-move-options></datalist>
          </div>
        </div>
        <div class="picker-panel__filter-section">
          <span class="picker-panel__section-title">Tipos</span>
          <div class="filter-group filter-group--compact" data-picker-type-filter aria-label="Filtrar por tipo"></div>
        </div>
        <div class="picker-panel__filter-section">
          <span class="picker-panel__section-title">Generaciones</span>
          <div class="filter-group filter-group--compact" data-picker-generation-filter aria-label="Filtrar por generación"></div>
        </div>
        <div class="picker-panel__filter-section">
          <span class="picker-panel__section-title">Juego</span>
          <div class="select-wrapper select-wrapper--compact">
            <i data-lucide="gamepad-2" class="select-wrapper__icon"></i>
            <select class="game-select" data-picker-game-filter aria-label="Filtrar por juego">
              <option value="">Todos los juegos</option>
            </select>
            <i data-lucide="chevron-down" class="select-wrapper__arrow"></i>
          </div>
        </div>
      </div>
      <div class="picker-panel__results" data-picker-results></div>
    </div>
  </div>

  <div class="modal-overlay" data-move-picker-overlay hidden>
    <div class="modal-panel move-picker-modal-panel">
      <div class="modal-panel__header">
        <div class="picker-panel__header-info">
          <h2><i data-lucide="swords"></i> <span data-move-picker-title>Seleccionar ataque</span></h2>
          <span class="picker-panel__count" data-move-picker-count></span>
        </div>
        <button class="modal-panel__close" type="button" data-move-picker-close aria-label="Cerrar modal">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="picker-panel__filters">
        <div class="picker-input-wrap">
          <i data-lucide="search" class="picker-input-icon"></i>
          <input class="picker-input" type="search" placeholder="Buscar por nombre de movimiento..." data-move-picker-search />
        </div>
        <div class="picker-panel__container">
          <div class="picker-panel__filter-section">
            <span class="picker-panel__section-title">Categoría</span>
            <div class="filter-group filter-group--compact" data-move-category-filter aria-label="Filtrar por categoría">
              <button class="filter-chip" type="button" data-category="all" aria-pressed="true">Todas</button>
              <button class="filter-chip" type="button" data-category="physical" aria-pressed="false">Físico</button>
              <button class="filter-chip" type="button" data-category="special" aria-pressed="false">Especial</button>
              <button class="filter-chip" type="button" data-category="status" aria-pressed="false">Estado</button>
            </div>
          </div>
          <div class="picker-panel__filter-section">
            <span class="picker-panel__section-title">Método de aprendizaje</span>
            <div class="filter-group filter-group--compact" data-move-method-filter aria-label="Filtrar por método">
              <button class="filter-chip" type="button" data-method="all" aria-pressed="true">Todos</button>
              <button class="filter-chip" type="button" data-method="level-up" aria-pressed="false">Nivel</button>
              <button class="filter-chip" type="button" data-method="machine" aria-pressed="false">MT/MO</button>
              <button class="filter-chip" type="button" data-method="tutor" aria-pressed="false">Tutor</button>
              <button class="filter-chip" type="button" data-method="egg" aria-pressed="false">Huevo</button>
            </div>
          </div>
        </div>
        <div class="picker-panel__filter-section">
          <span class="picker-panel__section-title">Tipo de Ataque</span>
          <div class="filter-group filter-group--compact" data-move-type-filter aria-label="Filtrar por tipo de ataque"></div>
        </div>
      </div>
      <div class="move-picker__results" data-move-picker-results></div>
    </div>
  </div>

  <PokemonDetailModal />

  <script>
    import "../scripts/team-page";
  </script>
</BaseLayout>
