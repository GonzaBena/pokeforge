---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Inicio">
  <div class="hero-container">
    <div class="hero-ambient-glow" aria-hidden="true"></div>
    <section class="hero">
      <div class="hero__badge">
        <i data-lucide="sparkles"></i>
        <span>PokeForge PWA v1.0 · Gen I a IX</span>
      </div>

      <h1 class="hero__title">
        Forjá tu equipo Pokémon <span class="hero__title-accent">definitivo</span>
      </h1>

      <p class="hero__subtitle">
        Explorá la Pokédex completa, registrá tus capturas y diseñá la estrategia perfecta analizando las fortalezas, debilidades y movimientos de tu equipo.
      </p>

      <div class="hero__actions">
        <a class="hero__card hero__card--pokedex" href="/pokedex/" data-astro-prefetch>
          <div class="hero__card-icon">
            <i data-lucide="book-open"></i>
          </div>
          <div class="hero__card-body">
            <strong>Explorar Pokédex</strong>
            <span>1025+ Pokémon con filtros por juego y gen</span>
          </div>
          <i data-lucide="arrow-right" class="hero__card-arrow"></i>
        </a>

        <a class="hero__card hero__card--equipo" href="/equipo/" data-astro-prefetch>
          <div class="hero__card-icon">
            <i data-lucide="swords"></i>
          </div>
          <div class="hero__card-body">
            <strong>Armar Equipo</strong>
            <span>Análisis táctico de tipos y debilidades</span>
          </div>
          <i data-lucide="arrow-right" class="hero__card-arrow"></i>
        </a>
      </div>

      <div class="hero__features">
        <div class="hero__feature">
          <i data-lucide="shield-check"></i>
          <div>
            <h4>Análisis de Tipos</h4>
            <p>Calculá resistencias e inmunidades al instante.</p>
          </div>
        </div>
        <div class="hero__feature">
          <i data-lucide="smartphone"></i>
          <div>
            <h4>Modo PWA Offline</h4>
            <p>Instalá y usá la app sin conexión.</p>
          </div>
        </div>
        <div class="hero__feature">
          <i data-lucide="gamepad-2"></i>
          <div>
            <h4>Filtros por Juego</h4>
            <p>Datos oficiales por versión y ubicación.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
