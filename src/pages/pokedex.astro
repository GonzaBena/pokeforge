---
import BaseLayout from "../layouts/BaseLayout.astro";
import CapturedCounter from "../components/CapturedCounter.astro";
import LoadMoreButton from "../components/LoadMoreButton.astro";
import PokemonDetailModal from "../components/PokemonDetailModal.astro";
---

<BaseLayout title="Pokédex">
  <div class="page">
    <div class="page__header">
      <div>
        <h1 class="page__title"><i data-lucide="book-open"></i> Pokédex</h1>
        <p class="page__subtitle">Explorá todos los Pokémon y marcá los que ya capturaste.</p>
      </div>
      <CapturedCounter />
    </div>

    <div class="filters-bar">
      <div class="view-toggle" data-view-toggle>
        <button class="view-toggle__btn" type="button" data-view="all" aria-pressed="true">Todos</button>
        <button class="view-toggle__btn" type="button" data-view="captured" aria-pressed="false">Capturados</button>
      </div>
      <input class="search-input" type="search" placeholder="Buscar por nombre o número..." data-search-input />
    </div>

    <div class="filter-stacks">
      <div class="filter-group" data-type-filter aria-label="Filtrar por tipo"></div>
      <div class="filter-group" data-generation-filter aria-label="Filtrar por generación"></div>
    </div>

    <div class="pokedex-grid" data-pokedex-grid></div>
    <p class="pokedex-empty" data-pokedex-empty hidden>No se encontraron Pokémon con esos filtros.</p>
    <LoadMoreButton />
  </div>

  <PokemonDetailModal />

  <script>
    import "../scripts/pokedex-page";
  </script>
</BaseLayout>
