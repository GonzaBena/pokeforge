---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getTranslations, getLocalizedPath, type Locale } from '../lib/i18n/translations'

const currentLocale = (Astro.currentLocale ?? 'en') as Locale
const t = getTranslations(currentLocale)
const homeHref = getLocalizedPath('/', currentLocale)
const blogHref = getLocalizedPath('/blog/', currentLocale)
---

<BaseLayout title={t.notFound.title}>
  <!-- Si el usuario llegó a una página del blog fuera de rango, redirigir automáticamente -->
  <script is:inline>
    ;(function () {
      const path = window.location.pathname
      const match = path.match(/^(\/(?:es\/)?blog)\/page\/(\d+)\/?$/)
      if (match) {
        const base = match[1]
        window.location.replace(base + '/')
      }
    })()
  </script>
  <main class="not-found-page">
    <div class="not-found-card">
      <!-- Sprite Pixel-Art Hierba Alta Oficial de Pokémon Rojo Fuego -->
      <div class="tall-grass-wrap" aria-hidden="true">
        <div class="tall-grass-glow"></div>
        <div class="tall-grass-stage">
          <!-- Sprite oficial de Rojo Fuego (16x16 escalado a 80x80) -->
          <img
            src="/tall_grass.png"
            alt="Hierba alta de Pokémon Rojo Fuego"
            class="tall-grass-sprite"
            width="80"
            height="80"
            loading="eager"
            decoding="async"
          />

          <!-- Sombra en el suelo -->
          <div class="tall-grass-shadow"></div>

          <!-- Globo de encuentro salvaje [ ! ] en hover -->
          <div class="tall-grass-encounter">!</div>
        </div>
      </div>
      <span class="not-found-badge">{t.notFound.badge}</span>
      <h1 class="not-found-title">{t.notFound.title}</h1>
      <p class="not-found-desc">{t.notFound.desc}</p>

      <div class="not-found-actions">
        <a href={blogHref} class="not-found-btn not-found-btn--primary">
          <i data-lucide="book-open"></i>
          <span>{t.notFound.backBlog}</span>
        </a>
        <a href={homeHref} class="not-found-btn not-found-btn--secondary">
          <i data-lucide="home"></i>
          <span>{t.notFound.backHome}</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .not-found-card {
    max-width: 480px;
    width: 100%;
    text-align: center;
    background: var(--color-surface, #18181b);
    border: 1px solid var(--color-border, #27272a);
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tall-grass-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    cursor: pointer;
    user-select: none;
  }

  .tall-grass-glow {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(74, 222, 128, 0.28) 0%,
      rgba(34, 197, 94, 0.12) 45%,
      transparent 75%
    );
    filter: blur(14px);
    z-index: 0;
    pointer-events: none;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
  }

  .tall-grass-stage {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .tall-grass-sprite {
    position: relative;
    z-index: 2;
    width: 80px;
    height: 80px;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    display: block;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tall-grass-shadow {
    position: absolute;
    bottom: -4px;
    left: 8px;
    right: 8px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.6) 0%, transparent 75%);
    z-index: 1;
    pointer-events: none;
  }

  /* Globo de encuentro salvaje [ ! ] */
  .tall-grass-encounter {
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%) scale(0) translateY(8px);
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #ef4444;
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(239, 68, 68, 0.5);
    border: 2px solid #ffffff;
    opacity: 0;
    z-index: 10;
    pointer-events: none;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.2s ease;
  }

  /* Interacciones al posar el cursor sobre la tarjeta o la hierba */
  .not-found-card:hover .tall-grass-encounter,
  .tall-grass-wrap:hover .tall-grass-encounter {
    transform: translateX(-50%) scale(1) translateY(0);
    opacity: 1;
  }

  .not-found-card:hover .tall-grass-sprite,
  .tall-grass-wrap:hover .tall-grass-sprite {
    animation: grassRustle 0.45s ease-in-out;
  }

  .not-found-card:hover .tall-grass-glow,
  .tall-grass-wrap:hover .tall-grass-glow {
    transform: scale(1.3);
    opacity: 0.95;
  }

  @keyframes grassRustle {
    0%,
    100% {
      transform: rotate(0deg) scale(1.05);
    }
    25% {
      transform: rotate(-3deg) scale(1.05);
    }
    75% {
      transform: rotate(3deg) scale(1.05);
    }
  }

  .not-found-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .not-found-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary, #f4f4f5);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .not-found-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a1a1aa);
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1 1 180px;
  }

  .not-found-btn--primary {
    background: #ef4444;
    color: #fff;
  }

  .not-found-btn--primary:hover {
    background: #dc2626;
    transform: translateY(-1px);
  }

  .not-found-btn--secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary, #f4f4f5);
    border: 1px solid var(--color-border, #27272a);
  }

  .not-found-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }
</style>
