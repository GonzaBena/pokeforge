---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTranslations, getLocalizedPath, type Locale } from "../lib/i18n/translations";

const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
const homeHref = getLocalizedPath("/", currentLocale);
const blogHref = getLocalizedPath("/blog/", currentLocale);
---

<BaseLayout title={t.notFound.title}>
  <!-- Si el usuario llegó a una página del blog fuera de rango, redirigir automáticamente -->
  <script is:inline>
    (function () {
      const path = window.location.pathname;
      const match = path.match(/^(\/(?:es\/)?blog)\/page\/(\d+)\/?$/);
      if (match) {
        const base = match[1];
        window.location.replace(base + "/");
      }
    })();
  </script>

  <main class="not-found-page">
    <div class="not-found-card">
      <div class="not-found-icon">
        <i data-lucide="compass"></i>
      </div>
      <span class="not-found-badge">{t.notFound.badge}</span>
      <h1 class="not-found-title">{t.notFound.title}</h1>
      <p class="not-found-desc">{t.notFound.desc}</p>

      <div class="not-found-actions">
        <a href={blogHref} class="not-found-btn not-found-btn--primary">
          <i data-lucide="book-open"></i>
          <span>{t.notFound.backBlog}</span>
        </a>
        <a href={homeHref} class="not-found-btn not-found-btn--secondary">
          <i data-lucide="home"></i>
          <span>{t.notFound.backHome}</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .not-found-card {
    max-width: 480px;
    width: 100%;
    text-align: center;
    background: var(--color-surface, #18181b);
    border: 1px solid var(--color-border, #27272a);
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .not-found-icon :global(svg) {
    width: 36px;
    height: 36px;
  }

  .not-found-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .not-found-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary, #f4f4f5);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .not-found-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a1a1aa);
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1 1 180px;
  }

  .not-found-btn--primary {
    background: #ef4444;
    color: #fff;
  }

  .not-found-btn--primary:hover {
    background: #dc2626;
    transform: translateY(-1px);
  }

  .not-found-btn--secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary, #f4f4f5);
    border: 1px solid var(--color-border, #27272a);
  }

  .not-found-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }
</style>
