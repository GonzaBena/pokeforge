---
import { getTranslations, type Locale } from "../lib/i18n/translations";

const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
---

<div class="modal-overlay" data-sync-overlay hidden>
  <div class="modal-panel sync-modal-panel">
    <div class="modal-panel__header">
      <div class="sync-modal__title-group">
        <i data-lucide="cloud"></i>
        <h2>{t.syncModal.modalTitle}</h2>
      </div>
      <button class="modal-panel__close" type="button" data-sync-close aria-label={t.syncModal.close}>
        <i data-lucide="x"></i>
      </button>
    </div>

    <!-- Pestañas de Navegación -->
    <div class="sync-nav-tabs">
      <button class="sync-nav-tab is-active" type="button" data-tab-target="cloud">
        <i data-lucide="cloud"></i>
        <span>{t.syncModal.tabCloud}</span>
      </button>
      <button class="sync-nav-tab" type="button" data-tab-target="qr">
        <i data-lucide="qr-code"></i>
        <span>{t.syncModal.tabQr}</span>
      </button>
    </div>

    <div class="sync-modal__body">
      <!-- PANEL 1: NUBE DB -->
      <div class="sync-tab-panel" data-tab-panel="cloud">
        <!-- Estado NO vinculado -->
        <div class="cloud-unlinked-state" data-cloud-unlinked>
          <div class="cloud-hero-icon">
            <i data-lucide="cloud"></i>
          </div>
          <h3 class="cloud-panel-title">{t.syncModal.cloudTitle}</h3>
          <p class="cloud-panel-desc">
            {t.syncModal.cloudDesc}
          </p>

          <button class="btn btn--primary cloud-primary-btn" type="button" data-cloud-create-btn>
            <i data-lucide="cloud"></i>
            <span>{t.syncModal.cloudCreate}</span>
          </button>

          <div class="sync-modal__divider">
            <span>{t.syncModal.cloudOrJoin}</span>
          </div>

          <div class="cloud-join-row">
            <input
              type="text"
              class="cloud-code-input"
              placeholder={t.syncModal.cloudCodePlaceholder}
              maxlength="300"
              data-cloud-join-input
              autocomplete="off"
              spellcheck="false"
            />
            <button class="btn btn--secondary" type="button" data-cloud-join-btn>
              <i data-lucide="link"></i>
              <span>{t.syncModal.cloudJoin}</span>
            </button>
          </div>
        </div>

        <!-- Estado VINCULADO -->
        <div class="cloud-linked-state" data-cloud-linked hidden>
          <div class="cloud-status-card">
            <div class="cloud-status-header">
              <span class="cloud-status-pill" data-cloud-status-pill>
                <span class="cloud-status-dot" data-cloud-status-dot></span>
                <span data-cloud-status-text>{t.syncModal.cloudConnected}</span>
              </span>
              <span class="cloud-last-sync" data-cloud-last-sync>{t.syncModal.cloudSynced}</span>
            </div>

            <div class="cloud-code-display">
              <span class="cloud-code-label">{t.syncModal.cloudCodeLabel}</span>
              <div class="cloud-code-val-wrap">
                <strong class="cloud-code-value" data-cloud-code-value>------</strong>
                <button class="cloud-code-copy-btn" type="button" data-cloud-copy-code title={t.syncModal.cloudCopyTitle}>
                  <i data-lucide="copy"></i>
                </button>
              </div>
            </div>

            <p class="cloud-code-help">
              {t.syncModal.cloudHelp}
            </p>
          </div>

          <!-- Sección QR de Vinculación para Celular (con permisos de lectura y escritura) -->
          <div class="cloud-pairing-card" data-cloud-pairing-card hidden>
            <div class="cloud-pairing-card__header">
              <i data-lucide="smartphone"></i>
              <div class="cloud-pairing-card__text">
                <strong>{t.syncModal.cloudQrTitle}</strong>
                <p>{t.syncModal.cloudQrDesc}</p>
              </div>
            </div>

            <div class="sync-modal__qr-wrapper cloud-pairing-qr-wrap">
              <canvas id="cloud-pairing-qr-canvas" class="sync-modal__canvas" width="180" height="180"></canvas>
              <div class="sync-modal__qr-loading" data-cloud-pairing-loading>
                <i data-lucide="loader-2" class="spin"></i>
                <span>{t.syncModal.qrGenerating}</span>
              </div>
            </div>

            <button class="btn btn--secondary btn--sm cloud-copy-pairing-btn" type="button" data-cloud-copy-pairing-link>
              <i data-lucide="copy"></i>
              <span>{t.syncModal.cloudCopyPairingLink}</span>
            </button>
          </div>

          <!-- Aviso Modo Solo Lectura (Si el dispositivo no tiene secretKey) -->
          <div class="cloud-readonly-box" data-cloud-readonly-box hidden>
            <div class="cloud-readonly-header">
              <i data-lucide="alert-circle"></i>
              <strong>{t.syncModal.cloudStatusReadOnly}</strong>
            </div>
            <p class="cloud-readonly-desc">
              {t.syncModal.cloudReadOnlyWarning}
            </p>
            <div class="cloud-readonly-form">
              <input
                type="text"
                class="cloud-code-input cloud-readonly-input"
                placeholder={t.syncModal.cloudUpgradeKeyPlaceholder}
                data-cloud-upgrade-key-input
                autocomplete="off"
                spellcheck="false"
              />
              <button class="btn btn--secondary btn--sm" type="button" data-cloud-upgrade-key-btn>
                <i data-lucide="key"></i>
                <span>{t.syncModal.cloudUpgradeKeyBtn}</span>
              </button>
            </div>
          </div>

          <div class="cloud-actions-grid">
            <button class="btn btn--secondary sync-modal__action-btn" type="button" data-cloud-sync-now>
              <i data-lucide="refresh-cw"></i>
              <span>{t.syncModal.cloudSyncNow}</span>
            </button>
            <button class="btn btn--secondary sync-modal__action-btn" type="button" data-cloud-unlink-btn>
              <i data-lucide="unlink"></i>
              <span>{t.syncModal.cloudUnlink}</span>
            </button>
          </div>

          <div class="cloud-danger-box">
            <button class="btn btn--danger-outline sync-modal__reset-trigger" type="button" data-cloud-delete-trigger>
              <i data-lucide="trash-2"></i>
              <span>{t.syncModal.cloudDeleteVault}</span>
            </button>

            <div class="sync-modal__confirm-box" data-cloud-delete-confirm hidden>
              <div class="sync-modal__confirm-header">
                <i data-lucide="alert-triangle"></i>
                <strong>{t.syncModal.cloudDeleteConfirmTitle}</strong>
              </div>
              <p class="sync-modal__confirm-text">
                {t.syncModal.cloudDeleteConfirmDesc}
              </p>
              <div class="sync-modal__confirm-actions">
                <button class="btn btn--danger btn--sm" type="button" data-cloud-confirm-delete>
                  <i data-lucide="trash-2"></i>
                  <span>{t.syncModal.cloudDeleteConfirmBtn}</span>
                </button>
                <button class="btn btn--secondary btn--sm" type="button" data-cloud-cancel-delete>
                  <span>{t.syncModal.cancel}</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 2: TRANSFERENCIA DIRECTA (QR / ARCHIVO) -->
      <div class="sync-tab-panel" data-tab-panel="qr" hidden>
        <!-- Sección QR -->
        <div class="sync-modal__qr-section">
          <p class="sync-modal__instructions">
            {t.syncModal.qrInstructions}
          </p>

          <div class="sync-modal__qr-wrapper">
            <canvas id="sync-qr-canvas" class="sync-modal__canvas" width="240" height="240"></canvas>
            <div class="sync-modal__qr-loading" data-sync-loading>
              <i data-lucide="loader-2" class="spin"></i>
              <span>{t.syncModal.qrGenerating}</span>
            </div>
          </div>

          <div class="sync-modal__stats" data-sync-stats>
            <!-- Estadísticas dinámicas -->
          </div>

          <button class="sync-modal__copy-btn" type="button" data-sync-copy-link>
            <i data-lucide="copy"></i>
            <span>{t.syncModal.qrCopyLink}</span>
          </button>
        </div>

        <!-- Sección Respaldo Manual -->
        <div class="sync-modal__manual-section">
          <div class="sync-modal__divider">
            <span>{t.syncModal.qrOrManual}</span>
          </div>
          <div class="sync-modal__actions-row">
            <button class="btn btn--secondary sync-modal__action-btn" type="button" data-sync-export-btn>
              <i data-lucide="download"></i>
              <span>{t.syncModal.qrExportJson}</span>
            </button>
            <button class="btn btn--secondary sync-modal__action-btn" type="button" data-sync-import-btn>
              <i data-lucide="upload"></i>
              <span>{t.syncModal.qrImportJson}</span>
            </button>
            <input type="file" accept=".json" class="visually-hidden" data-sync-file-input hidden aria-hidden="true" />
          </div>
        </div>
      </div>

      <!-- Sección Gestión de Datos / Reinicio Local (Común a ambas) -->
      <div class="sync-modal__danger-section">
        <div class="sync-modal__divider">
          <span>{t.syncModal.dangerLocalData}</span>
        </div>

        <div class="sync-modal__reset-wrapper" data-sync-reset-default>
          <button class="btn btn--danger-outline sync-modal__reset-trigger" type="button" data-sync-reset-trigger>
            <i data-lucide="trash-2"></i>
            <span>{t.syncModal.dangerResetBtn}</span>
          </button>
        </div>

        <div class="sync-modal__confirm-box" data-sync-reset-confirm hidden>
          <div class="sync-modal__confirm-header">
            <i data-lucide="alert-triangle"></i>
            <strong>{t.syncModal.dangerResetTitle}</strong>
          </div>
          <p class="sync-modal__confirm-text" data-sync-confirm-msg>
            {t.syncModal.dangerResetDesc}
          </p>
          <div class="sync-modal__confirm-actions">
            <button class="btn btn--danger btn--sm" type="button" data-sync-confirm-delete>
              <i data-lucide="trash-2"></i>
              <span>{t.syncModal.dangerResetConfirm}</span>
            </button>
            <button class="btn btn--secondary btn--sm" type="button" data-sync-cancel-delete>
              <span>{t.syncModal.cancel}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    generateSyncUrl,
    renderQrCode,
    exportBackupFile,
    importBackupFile,
    generateCloudPairingUrl,
  } from "../lib/sync";
  import { getCapturedIds, getTeam, resetAllData } from "../lib/storage";
  import {
    getCloudState,
    createCloudVault,
    joinCloudVault,
    syncToCloudNow,
    unlinkCloudVault,
    deleteCloudVault,
    setCloudSecretKey,
    initCloudSyncClient,
    CLOUD_STATUS_EVENT,
    type CloudState,
  } from "../lib/cloudSync";
  import { toast } from "../lib/toast";
  import { refreshIcons } from "../lib/icons";
  import { getCurrentLocale, getTranslations } from "../lib/i18n/translations";

  function initSyncModal() {
    const overlay = document.querySelector<HTMLDivElement>("[data-sync-overlay]");
    if (!overlay) return;

    // Inicializar cliente global de sincronización
    initCloudSyncClient();

    const closeBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-close]");
    const tabBtns = overlay.querySelectorAll<HTMLButtonElement>("[data-tab-target]");
    const tabPanels = overlay.querySelectorAll<HTMLDivElement>("[data-tab-panel]");

    // Elementos QR
    const canvas = overlay.querySelector<HTMLCanvasElement>("#sync-qr-canvas");
    const loading = overlay.querySelector<HTMLDivElement>("[data-sync-loading]");
    const statsEl = overlay.querySelector<HTMLDivElement>("[data-sync-stats]");
    const copyBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-copy-link]");
    const exportBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-export-btn]");
    const importBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-import-btn]");
    const fileInput = overlay.querySelector<HTMLInputElement>("[data-sync-file-input]");

    // Elementos Cloud
    const cloudUnlinked = overlay.querySelector<HTMLDivElement>("[data-cloud-unlinked]");
    const cloudLinked = overlay.querySelector<HTMLDivElement>("[data-cloud-linked]");
    const cloudCreateBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-create-btn]");
    const cloudJoinInput = overlay.querySelector<HTMLInputElement>("[data-cloud-join-input]");
    const cloudJoinBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-join-btn]");
    const cloudCodeValue = overlay.querySelector<HTMLElement>("[data-cloud-code-value]");
    const cloudCopyCode = overlay.querySelector<HTMLButtonElement>("[data-cloud-copy-code]");
    const cloudLastSyncEl = overlay.querySelector<HTMLElement>("[data-cloud-last-sync]");
    const cloudStatusDot = overlay.querySelector<HTMLElement>("[data-cloud-status-dot]");
    const cloudStatusText = overlay.querySelector<HTMLElement>("[data-cloud-status-text]");
    const cloudPairingCard = overlay.querySelector<HTMLDivElement>("[data-cloud-pairing-card]");
    const cloudPairingCanvas = overlay.querySelector<HTMLCanvasElement>("#cloud-pairing-qr-canvas");
    const cloudPairingLoading = overlay.querySelector<HTMLDivElement>("[data-cloud-pairing-loading]");
    const cloudCopyPairingBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-copy-pairing-link]");
    const cloudReadOnlyBox = overlay.querySelector<HTMLDivElement>("[data-cloud-readonly-box]");
    const cloudUpgradeKeyInput = overlay.querySelector<HTMLInputElement>("[data-cloud-upgrade-key-input]");
    const cloudUpgradeKeyBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-upgrade-key-btn]");
    const cloudSyncNowBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-sync-now]");
    const cloudUnlinkBtn = overlay.querySelector<HTMLButtonElement>("[data-cloud-unlink-btn]");
    const cloudDeleteTrigger = overlay.querySelector<HTMLButtonElement>("[data-cloud-delete-trigger]");
    const cloudDeleteConfirm = overlay.querySelector<HTMLDivElement>("[data-cloud-delete-confirm]");
    const cloudConfirmDelete = overlay.querySelector<HTMLButtonElement>("[data-cloud-confirm-delete]");
    const cloudCancelDelete = overlay.querySelector<HTMLButtonElement>("[data-cloud-cancel-delete]");

    // Elementos Reset Local
    const resetTrigger = overlay.querySelector<HTMLButtonElement>("[data-sync-reset-trigger]");
    const resetDefault = overlay.querySelector<HTMLDivElement>("[data-sync-reset-default]");
    const resetConfirm = overlay.querySelector<HTMLDivElement>("[data-sync-reset-confirm]");
    const confirmMsg = overlay.querySelector<HTMLParagraphElement>("[data-sync-confirm-msg]");
    const confirmDeleteBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-confirm-delete]");
    const cancelDeleteBtn = overlay.querySelector<HTMLButtonElement>("[data-sync-cancel-delete]");

    let currentSyncUrl = "";
    let currentPairingUrl = "";

    // Pestañas
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.tabTarget;
        tabBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        tabPanels.forEach((p) => {
          p.hidden = p.dataset.tabPanel !== target;
        });
        refreshIcons();
      });
    });

    function formatTime(ts: number | null): string {
      if (!ts) return "Pendiente";
      const diffSec = Math.floor((Date.now() - ts) / 1000);
      if (diffSec < 10) return "Recién actualizado";
      if (diffSec < 60) return `Hace ${diffSec}s`;
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) return `Hace ${diffMin} min`;
      return new Date(ts).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    }

    async function renderCloudPairingQr(code: string, secretKey: string) {
      if (!cloudPairingCanvas || !cloudPairingLoading) return;
      cloudPairingLoading.style.display = "flex";
      try {
        currentPairingUrl = generateCloudPairingUrl(code, secretKey, window.location.origin, getCurrentLocale());
        await renderQrCode(cloudPairingCanvas, currentPairingUrl);
        cloudPairingLoading.style.display = "none";
      } catch (err) {
        console.error("Error al generar QR de vinculación:", err);
        cloudPairingLoading.innerHTML = `<span>Error QR</span>`;
      }
    }

    function renderCloudUI(state: CloudState) {
      if (!cloudUnlinked || !cloudLinked) return;
      const locale = getCurrentLocale();
      const t = getTranslations(locale);

      if (state.isLinked) {
        cloudUnlinked.hidden = true;
        cloudLinked.hidden = false;
        if (cloudCodeValue) cloudCodeValue.textContent = state.code || "------";
        if (cloudLastSyncEl) cloudLastSyncEl.textContent = formatTime(state.lastSync);

        if (state.secretKey && state.code) {
          if (cloudStatusDot) cloudStatusDot.classList.remove("cloud-status-dot--readonly");
          if (cloudStatusText) cloudStatusText.textContent = t.syncModal.cloudStatusReadWrite;
          if (cloudPairingCard) cloudPairingCard.hidden = false;
          if (cloudReadOnlyBox) cloudReadOnlyBox.hidden = true;
          renderCloudPairingQr(state.code, state.secretKey);
        } else {
          if (cloudStatusDot) cloudStatusDot.classList.add("cloud-status-dot--readonly");
          if (cloudStatusText) cloudStatusText.textContent = t.syncModal.cloudStatusReadOnly;
          if (cloudPairingCard) cloudPairingCard.hidden = true;
          if (cloudReadOnlyBox) cloudReadOnlyBox.hidden = false;
        }
      } else {
        cloudUnlinked.hidden = false;
        cloudLinked.hidden = true;
        if (cloudPairingCard) cloudPairingCard.hidden = true;
        if (cloudReadOnlyBox) cloudReadOnlyBox.hidden = true;
      }

      if (cloudDeleteConfirm) cloudDeleteConfirm.hidden = true;
      if (cloudDeleteTrigger) cloudDeleteTrigger.hidden = false;
      refreshIcons();
    }

    function hideResetConfirmation() {
      if (resetConfirm) resetConfirm.hidden = true;
      if (resetDefault) resetDefault.hidden = false;
    }

    function showResetConfirmation() {
      const capturedCount = getCapturedIds().size;
      const team = getTeam();
      const activeMembers = team.slots.filter((s) => s.pokemonId !== null).length;
      if (confirmMsg) {
        confirmMsg.textContent = `Se borrarán tus ${capturedCount} Pokémon capturados y tu equipo actual (${activeMembers} miembros). Esta acción no se puede deshacer.`;
      }
      if (resetDefault) resetDefault.hidden = true;
      if (resetConfirm) resetConfirm.hidden = false;
      refreshIcons();
    }

    async function openModal() {
      overlay!.hidden = false;
      document.body.style.overflow = "hidden";
      hideResetConfirmation();
      renderCloudUI(getCloudState());
      refreshIcons();

      // Estadísticas actuales
      const locale = getCurrentLocale();
      const capturedCount = getCapturedIds().size;
      const team = getTeam();
      const activeMembers = team.slots.filter((s) => s.pokemonId !== null).length;
      if (statsEl) {
        statsEl.innerHTML = `
          <div class="sync-stat-chip">
            <i data-lucide="users"></i>
            <span>${activeMembers} ${locale === "es" ? "en equipo" : "in team"}</span>
          </div>
          <div class="sync-stat-chip">
            <i data-lucide="check"></i>
            <span>${capturedCount} ${locale === "es" ? "capturados" : "caught"}</span>
          </div>
        `;
        refreshIcons();
      }

      // Generación del código QR
      if (canvas && loading) {
        loading.style.display = "flex";
        try {
          currentSyncUrl = await generateSyncUrl();
          await renderQrCode(canvas, currentSyncUrl);
          loading.style.display = "none";
        } catch (err) {
          console.error("Error al generar QR:", err);
          loading.innerHTML = `<span>${locale === "es" ? "Error al generar código QR" : "Error generating QR code"}</span>`;
        }
      }
    }

    function closeModal() {
      overlay!.hidden = true;
      document.body.style.overflow = "";
      hideResetConfirmation();
    }

    // Escuchar triggers globales con [data-sync-open]
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("[data-sync-open]");
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    closeBtn?.addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) closeModal();
    });

    // Eventos Cloud
    window.addEventListener(CLOUD_STATUS_EVENT, (e) => {
      const detail = (e as CustomEvent<CloudState>).detail;
      if (detail) renderCloudUI(detail);
    });

    cloudCreateBtn?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      cloudCreateBtn.disabled = true;
      toast.info(locale === "es" ? "Creando bóveda en la DB..." : "Creating vault in DB...");
      const res = await createCloudVault();
      cloudCreateBtn.disabled = false;
      if (res.success) {
        toast.success(locale === "es" ? `¡Bóveda creada! Tu código es: ${res.code}` : `Vault created! Your code is: ${res.code}`);
      } else {
        toast.error(res.error || (locale === "es" ? "No se pudo conectar a la nube" : "Could not connect to the cloud"));
      }
    });

    cloudJoinBtn?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      const rawInput = cloudJoinInput?.value?.trim();
      if (!rawInput) {
        toast.info(locale === "es" ? "Ingresa un código de 6 caracteres o enlace" : "Enter a 6-character code or link");
        return;
      }

      let code = rawInput;
      let secretKey: string | undefined;

      const vaultMatch = rawInput.match(/vault=([^&]+)/i);
      if (vaultMatch) {
        code = decodeURIComponent(vaultMatch[1]).toUpperCase().trim();
        const keyMatch = rawInput.match(/key=([^&]+)/i);
        if (keyMatch) {
          secretKey = decodeURIComponent(keyMatch[1]).trim();
        }
      }

      cloudJoinBtn.disabled = true;
      toast.info(locale === "es" ? "Conectando con la DB..." : "Connecting to DB...");
      const res = await joinCloudVault(code, secretKey);
      cloudJoinBtn.disabled = false;
      if (res.success) {
        toast.success(
          secretKey
            ? (locale === "es" ? "¡Dispositivo vinculado con permisos de escritura!" : "Device linked with write permissions!")
            : (locale === "es" ? "¡Dispositivo vinculado con éxito!" : "Device linked successfully!")
        );
        if (cloudJoinInput) cloudJoinInput.value = "";
      } else {
        toast.error(res.error || (locale === "es" ? "Código no válido o no encontrado" : "Invalid or not found code"));
      }
    });

    cloudCopyPairingBtn?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      const t = getTranslations(locale);
      const state = getCloudState();
      if (!state.code || !state.secretKey) return;
      if (!currentPairingUrl) {
        currentPairingUrl = generateCloudPairingUrl(state.code, state.secretKey, window.location.origin, locale);
      }
      try {
        await navigator.clipboard.writeText(currentPairingUrl);
        toast.success(t.syncModal.cloudPairingLinkCopied);
      } catch {
        toast.info(t.syncModal.cloudCopyTitle + ": " + currentPairingUrl);
      }
    });

    cloudUpgradeKeyBtn?.addEventListener("click", () => {
      const locale = getCurrentLocale();
      const t = getTranslations(locale);
      const keyVal = cloudUpgradeKeyInput?.value?.trim();
      if (!keyVal) {
        toast.info(locale === "es" ? "Ingresá tu clave secreta" : "Enter your secret key");
        return;
      }
      setCloudSecretKey(keyVal);
      if (cloudUpgradeKeyInput) cloudUpgradeKeyInput.value = "";
      toast.success(t.syncModal.cloudUpgradeSuccess);
    });

    cloudCopyCode?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      const state = getCloudState();
      if (!state.code) return;
      try {
        await navigator.clipboard.writeText(state.code);
        toast.success(locale === "es" ? "¡Código copiado al portapapeles!" : "Code copied to clipboard!");
      } catch {
        toast.info(locale === "es" ? "Copia el código manualmente: " + state.code : "Copy the code manually: " + state.code);
      }
    });

    cloudSyncNowBtn?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      cloudSyncNowBtn.disabled = true;
      toast.info(locale === "es" ? "Sincronizando..." : "Syncing...");
      const res = await syncToCloudNow();
      cloudSyncNowBtn.disabled = false;
      if (res.success) {
        toast.success(locale === "es" ? "¡Datos sincronizados con la DB!" : "Data synced with DB!");
      } else {
        toast.error(res.error || (locale === "es" ? "Error al sincronizar" : "Error syncing"));
      }
    });

    cloudUnlinkBtn?.addEventListener("click", () => {
      const locale = getCurrentLocale();
      unlinkCloudVault();
      toast.info(locale === "es" ? "Dispositivo desvinculado. Recargando..." : "Device unlinked. Reloading...");
      setTimeout(() => {
        window.location.reload();
      }, 400);
    });

    cloudDeleteTrigger?.addEventListener("click", () => {
      if (cloudDeleteConfirm) cloudDeleteConfirm.hidden = false;
      if (cloudDeleteTrigger) cloudDeleteTrigger.hidden = true;
      refreshIcons();
    });

    cloudCancelDelete?.addEventListener("click", () => {
      if (cloudDeleteConfirm) cloudDeleteConfirm.hidden = true;
      if (cloudDeleteTrigger) cloudDeleteTrigger.hidden = false;
    });

    cloudConfirmDelete?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      cloudConfirmDelete.disabled = true;
      const res = await deleteCloudVault();
      cloudConfirmDelete.disabled = false;
      if (res.success) {
        toast.success(locale === "es" ? "Bóveda eliminada permanentemente de la DB." : "Vault permanently deleted from DB.");
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        toast.error(res.error || (locale === "es" ? "Error al eliminar la bóveda" : "Error deleting vault"));
      }
    });

    // Copiar enlace QR
    copyBtn?.addEventListener("click", async () => {
      const locale = getCurrentLocale();
      if (!currentSyncUrl) currentSyncUrl = await generateSyncUrl();
      try {
        await navigator.clipboard.writeText(currentSyncUrl);
        toast.success(locale === "es" ? "¡Enlace de sincronización copiado!" : "Sync link copied!");
      } catch {
        toast.info(locale === "es" ? "Copia el enlace manualmente desde la barra" : "Copy the link manually from address bar");
      }
    });

    exportBtn?.addEventListener("click", () => {
      const locale = getCurrentLocale();
      try {
        exportBackupFile();
        toast.success(locale === "es" ? "Archivo de respaldo descargado" : "Backup file downloaded");
      } catch {
        toast.error(locale === "es" ? "Error al exportar el respaldo" : "Error exporting backup");
      }
    });

    importBtn?.addEventListener("click", () => {
      fileInput?.click();
    });

    fileInput?.addEventListener("change", async () => {
      const locale = getCurrentLocale();
      const file = fileInput.files?.[0];
      if (!file) return;
      try {
        const result = await importBackupFile(file, "merge");
        toast.success(locale === "es" ? `¡Sincronizado! Se añadieron ${result.addedCaptures} nuevas capturas.` : `Synced! Added ${result.addedCaptures} new captures.`);
        closeModal();
      } catch {
        toast.error(locale === "es" ? "El archivo no tiene un formato válido" : "File does not have a valid format");
      } finally {
        fileInput.value = "";
      }
    });

    resetTrigger?.addEventListener("click", showResetConfirmation);
    cancelDeleteBtn?.addEventListener("click", hideResetConfirmation);

    confirmDeleteBtn?.addEventListener("click", () => {
      const locale = getCurrentLocale();
      resetAllData();
      hideResetConfirmation();
      closeModal();
      toast.success(locale === "es" ? "Todos tus datos han sido reiniciados a cero." : "All your data has been reset to zero.");
    });
  }

  initSyncModal();
  document.addEventListener("astro:after-swap", initSyncModal);
</script>
