---
import { getTranslations, type Locale } from "../lib/i18n/translations";
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
---

<div class="modal-overlay" data-detail-overlay hidden>
  <div class="modal-panel detail-modal-panel">
    <div class="modal-panel__header">
      <h2>{currentLocale === "es" ? "Detalle del Pokémon" : "Pokémon Details"}</h2>
      <button class="modal-panel__close" type="button" data-detail-close aria-label={t.modal.close}>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="detail-modal__body" data-detail-body></div>
  </div>
</div>
