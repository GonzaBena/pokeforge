---
import { getTranslations, type Locale } from "../lib/i18n/translations";

interface Props {
  path?: string;
  url?: string;
  src?: string;
  href?: string;
  text?: string;
  title?: string;
  description?: string;
  size?: string;
  format?: string;
  fileName?: string;
  buttonText?: string;
}

const {
  path,
  url,
  src,
  href,
  text,
  title,
  description,
  size,
  format: customFormat,
  fileName,
  buttonText,
} = Astro.props;

const currentLocale = (Astro.currentLocale ?? "es") as Locale;
const t = getTranslations(currentLocale);

// Resolver ruta y título soportando aliases amigables
const fileUrl = path || url || src || href || "#";
const fileTitle = text || title || fileUrl.split("/").pop() || "Descarga";

// Extraer automáticamente la extensión de la ruta
function extractExtension(rawUrl: string): string {
  try {
    const clean = rawUrl.split("?")[0].split("#")[0];
    const parts = clean.split(".");
    if (parts.length > 1) {
      const ext = parts.pop()?.trim().toUpperCase() || "";
      if (ext.length >= 1 && ext.length <= 5 && !ext.includes("/")) {
        return ext;
      }
    }
  } catch {}
  return "FILE";
}

const detectedExt = customFormat
  ? customFormat.toUpperCase()
  : extractExtension(fileUrl);

// Determinar icono y clase de color según el tipo de archivo
function getFileInfo(ext: string): { icon: string; badgeClass: string } {
  switch (ext) {
    case "PDF":
      return { icon: "file-text", badgeClass: "badge-pdf" };
    case "PNG":
    case "JPG":
    case "JPEG":
    case "WEBP":
    case "SVG":
    case "GIF":
    case "AVIF":
      return { icon: "image", badgeClass: "badge-image" };
    case "ZIP":
    case "RAR":
    case "7Z":
    case "TAR":
    case "GZ":
      return { icon: "archive", badgeClass: "badge-archive" };
    case "SAV":
    case "DAT":
    case "BIN":
    case "PKM":
    case "PK9":
      return { icon: "hard-drive", badgeClass: "badge-save" };
    case "JSON":
    case "CSV":
    case "XLSX":
    case "XLS":
    case "TXT":
      return { icon: "file-spreadsheet", badgeClass: "badge-data" };
    default:
      return { icon: "file-down", badgeClass: "badge-default" };
  }
}

const { icon, badgeClass } = getFileInfo(detectedExt);
const actionLabel = buttonText || t.blog?.downloadAction || "Descargar";
---

<div class="download-card">
  <div class={`download-card__icon ${badgeClass}`} aria-hidden="true">
    <i data-lucide={icon}></i>
  </div>

  <div class="download-card__body">
    <div class="download-card__meta">
      <span class={`download-badge ${badgeClass}`}>{detectedExt}</span>
      {size && <span class="download-size">{size}</span>}
    </div>
    <h4 class="download-card__title">{fileTitle}</h4>
    {description && <p class="download-card__desc">{description}</p>}
  </div>

  <div class="download-card__action">
    <a
      href={fileUrl}
      download={fileName !== undefined ? fileName : true}
      class="download-btn"
      aria-label={`${actionLabel}: ${fileTitle}`}
    >
      <i data-lucide="download"></i>
      <span>{actionLabel}</span>
    </a>
  </div>
</div>

<style>
  .download-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.15rem 1.35rem;
    margin: 1.5rem 0;
    background: var(--bg-card, #1c1c24);
    border: 1px solid var(--border, #2a2a35);
    border-radius: var(--radius-md, 14px);
    box-shadow: var(--shadow-card, 0 8px 24px rgba(0, 0, 0, 0.25));
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .download-card:hover {
    background: var(--bg-card-hover, #232330);
    border-color: var(--border-strong, #3a3a4a);
    transform: translateY(-2px);
  }

  .download-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm, 8px);
    flex-shrink: 0;
    font-size: 1.25rem;
  }

  .download-card__body {
    flex: 1;
    min-width: 0;
  }

  .download-card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
  }

  .download-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .download-size {
    font-size: 0.75rem;
    color: var(--text-faint, #6c6b7c);
    font-weight: 500;
  }

  .download-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text, #f2f1f6);
    margin: 0;
    line-height: 1.3;
  }

  .download-card__desc {
    font-size: 0.85rem;
    color: var(--text-muted, #a3a2b3);
    margin: 0.3rem 0 0 0;
    line-height: 1.4;
  }

  .download-card__action {
    flex-shrink: 0;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    background: var(--accent, #ef4444);
    color: #ffffff !important;
    text-decoration: none !important;
    border-radius: var(--radius-sm, 8px);
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    transition: all 0.2s ease;
  }

  .download-btn:hover {
    background: var(--accent-strong, #dc2626);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(239, 68, 68, 0.35);
  }

  .download-btn i {
    width: 16px;
    height: 16px;
  }

  /* Variantes de color por tipo de archivo */
  .badge-pdf {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }
  .download-card__icon.badge-pdf {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }

  .badge-image {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }
  .download-card__icon.badge-image {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
  }

  .badge-archive {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
  }
  .download-card__icon.badge-archive {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
  }

  .badge-save {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
  }
  .download-card__icon.badge-save {
    background: rgba(168, 85, 247, 0.12);
    color: #a855f7;
  }

  .badge-data {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }
  .download-card__icon.badge-data {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }

  .badge-default {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-muted, #a3a2b3);
  }
  .download-card__icon.badge-default {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text, #f2f1f6);
  }

  @media (max-width: 640px) {
    .download-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.1rem;
    }

    .download-card__action {
      width: 100%;
    }

    .download-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
