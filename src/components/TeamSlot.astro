---
import TypeBadge from "./TypeBadge.astro";
import type { Pokemon } from "../lib/types";
import { getNatureName, getTranslations, type Locale } from "../lib/i18n/translations";
import { getItemDisplayName, getItemSpriteUrl } from "../lib/items";

interface Props {
  index: number;
  pokemon: Pokemon | null;
  nature?: string | null;
  item?: string | null;
}

const { index, pokemon, nature = null, item = null } = Astro.props;
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
const sprite = pokemon ? pokemon.sprites.officialArtwork ?? pokemon.sprites.default ?? "" : "";
const dexNumber = pokemon ? `#${String(pokemon.id).padStart(4, "0")}` : "";
const itemDisplayName = getItemDisplayName(item, currentLocale);
const itemSpriteUrl = getItemSpriteUrl(item);
---

<div class:list={["team-slot", { filled: !!pokemon }]} data-team-slot data-slot-index={index}>
  {pokemon ? (
    <>
      <button class="team-slot__remove-btn" type="button" data-remove-slot data-slot-index={index} aria-label={currentLocale === "es" ? "Quitar Pokémon" : "Remove Pokémon"}>
        <i data-lucide="x"></i>
      </button>
      <div class="team-slot__card-content">
        <div class="team-slot__sprite-col">
          <img class="team-slot__sprite" src={sprite} alt={pokemon.name} loading="lazy" />
        </div>
        <div class="team-slot__info-col">
          <span class="team-slot__id">{dexNumber}</span>
          <div class="team-slot__name">{pokemon.name}</div>
          <div class="pokemon-card__types">
            {pokemon.types.map((t) => <TypeBadge type={t} />)}
          </div>
          <div class="team-slot__pills-row">
            {nature && (
              <div class="team-slot__nature-pill" title={currentLocale === "es" ? `Naturaleza: ${getNatureName(nature, currentLocale)}` : `Nature: ${getNatureName(nature, currentLocale)}`}>
                <i data-lucide="sparkle"></i>
                <span>{getNatureName(nature, currentLocale)}</span>
              </div>
            )}
            {item ? (
              <div class="team-slot__item-pill" draggable="true" title={currentLocale === "es" ? `Objeto: ${itemDisplayName} (Arrastrá para mover o soltá fuera para quitar)` : `Item: ${itemDisplayName} (Drag to move or drop outside to unequip)`} data-select-item data-item-pill data-slot-index={index}>
                {itemSpriteUrl ? (
                  <span class="item-icon-wrapper" style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex-shrink:0;">
                    <img src={itemSpriteUrl} alt="" class="item-sprite" width="16" height="16" loading="lazy" style="width:16px;height:16px;object-fit:contain;image-rendering:pixelated;" onerror="this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display='inline-flex';" />
                    <i data-lucide="backpack" style="display:none;width:16px;height:16px;"></i>
                  </span>
                ) : (
                  <i data-lucide="backpack"></i>
                )}
                <span>{itemDisplayName}</span>
              </div>
            ) : (
              <button class="team-slot__item-btn empty" type="button" data-select-item data-slot-index={index} title={t.team.chooseItem}>
                <i data-lucide="backpack"></i>
                <span>{t.team.item}</span>
              </button>
            )}
          </div>
        </div>
      </div>
    </>
  ) : (
    <>
      <i data-lucide="plus-circle"></i>
      <span>{t.team.choosePokemon}</span>
    </>
  )}
</div>
