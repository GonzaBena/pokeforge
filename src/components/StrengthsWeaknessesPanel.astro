---
import { getTranslations, type Locale } from "../lib/i18n/translations";
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
---

<aside class="side-panel" data-strengths-panel>
  <h2 class="side-panel__title">{t.strengthsWeaknesses.title}</h2>
  <p class="side-panel__empty" data-panel-empty>{t.strengthsWeaknesses.noTeam}</p>
  <div data-panel-content hidden>
    <div class="type-bar-group">
      <div class="type-bar-group__label">
        <i data-lucide="trending-down"></i> {t.strengthsWeaknesses.weaknesses}
      </div>
      <div data-weaknesses-list></div>
    </div>
    <div class="type-bar-group">
      <div class="type-bar-group__label">
        <i data-lucide="shield-check"></i> {t.strengthsWeaknesses.resistances}
      </div>
      <div data-resistances-list></div>
    </div>
    <div class="type-bar-group">
      <div class="type-bar-group__label">
        <i data-lucide="shield-off"></i> {t.strengthsWeaknesses.immunities} (0.00x)
      </div>
      <div data-immunities-list></div>
    </div>
  </div>
</aside>
