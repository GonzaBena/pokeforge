---
import { getTranslations, getLocalizedPath, type Locale } from "../lib/i18n/translations";

interface Props {
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { alternateUrls } = Astro.props;

const path = Astro.url.pathname;
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);

const homePath = getLocalizedPath("/", currentLocale);
const pokedexPath = getLocalizedPath("/pokedex/", currentLocale);
const equipoPath = getLocalizedPath("/equipo/", currentLocale);
const blogPath = getLocalizedPath("/blog/", currentLocale);

const enHref = alternateUrls?.en ?? getLocalizedPath(path, "en");
const esHref = alternateUrls?.es ?? getLocalizedPath(path, "es");

const isHome = currentLocale === "es" ? (path === "/es" || path === "/es/") : (path === "/" || path === "");
const isPokedex = currentLocale === "es" ? path.startsWith("/es/pokedex") : path.startsWith("/pokedex");
const isEquipo = currentLocale === "es" ? path.startsWith("/es/equipo") : path.startsWith("/equipo");
const isBlog = currentLocale === "es" ? path.startsWith("/es/blog") : path.startsWith("/blog");
---

<nav class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href={homePath} data-astro-prefetch>
      <img src="/favicon.png" alt="PokeForge Logo" class="nav__brand-logo" />
      <span>PokeForge</span>
    </a>
    <div class="nav__right">
      <a class="nav__link" href={pokedexPath} data-astro-prefetch aria-current={isPokedex ? "page" : undefined}>
        <i data-lucide="book-open"></i>
        {t.nav.pokedex}
      </a>
      <a class="nav__link" href={equipoPath} data-astro-prefetch aria-current={isEquipo ? "page" : undefined}>
        <i data-lucide="users"></i>
        {t.nav.team}
      </a>
      <a class="nav__link" href={blogPath} data-astro-prefetch aria-current={isBlog ? "page" : undefined}>
        <i data-lucide="book"></i>
        {t.nav.blog}
      </a>
      <div class="nav__lang-toggle" aria-label="Language selector">
        <a href={enHref} class:list={["nav__lang-btn", { active: currentLocale === "en" }]} data-astro-prefetch>EN</a>
        <span class="nav__lang-divider">/</span>
        <a href={esHref} class:list={["nav__lang-btn", { active: currentLocale === "es" }]} data-astro-prefetch>ES</a>
      </div>
      <div class="nav__pwa-wrapper nav__pwa-wrapper--desktop" data-pwa-row hidden>
        <button class="nav__pwa-btn" type="button" data-pwa-install title={t.nav.installAppTitle} aria-label={t.nav.installAppTitle}>
          <i data-lucide="download"></i>
          <span>{t.nav.installApp}</span>
        </button>
      </div>
      <button
        class="nav__sync-btn"
        type="button"
        data-sync-open
        data-cloud-btn
        title={t.nav.syncTitle}
        aria-label={t.nav.syncTitle}
      >
        <span class="nav__cloud-wrapper" aria-hidden="true">
          <!-- 1. Sincronizado / Guardado (Google Docs: Nube con check) -->
          <span class="nav__cloud-icon nav__cloud-icon--synced" data-cloud-state="synced" hidden>
            <i data-lucide="cloud"></i>
            <span class="nav__cloud-badge nav__cloud-badge--check">
              <i data-lucide="check"></i>
            </span>
          </span>
          <!-- 2. Sincronizando / Guardando... (Nube con spinner) -->
          <span class="nav__cloud-icon nav__cloud-icon--syncing" data-cloud-state="syncing" hidden>
            <i data-lucide="cloud"></i>
            <span class="nav__cloud-badge nav__cloud-badge--spin">
              <i data-lucide="loader-2" class="spin"></i>
            </span>
          </span>
          <!-- 3. Offline / Sin conexión (Nube tachada) -->
          <span class="nav__cloud-icon nav__cloud-icon--offline" data-cloud-state="offline" hidden>
            <i data-lucide="cloud-off"></i>
          </span>
          <!-- 4. Error al guardar (Nube con alerta) -->
          <span class="nav__cloud-icon nav__cloud-icon--error" data-cloud-state="error" hidden>
            <i data-lucide="cloud"></i>
            <span class="nav__cloud-badge nav__cloud-badge--error">
              <i data-lucide="alert-triangle"></i>
            </span>
          </span>
          <!-- 5. No vinculado / Solo local (Nube por defecto) -->
          <span class="nav__cloud-icon nav__cloud-icon--unlinked" data-cloud-state="unlinked">
            <i data-lucide="cloud"></i>
          </span>
        </span>
        <span class="nav__sync-text" data-cloud-text>{t.nav.sync}</span>
      </button>
      <button class="nav__sound-btn" type="button" data-sound-toggle title={t.nav.soundTitle} aria-label={t.nav.soundTitle}>
        <i data-lucide="volume-2" data-sound-icon-on></i>
        <i data-lucide="volume-x" data-sound-icon-off hidden></i>
      </button>
    </div>
  </div>

  <!-- Fila exclusiva para botón de instalar en celulares (evita superposición con el logo) -->
  <div class="nav__pwa-mobile-row" data-pwa-row hidden>
    <button class="nav__pwa-mobile-btn" type="button" data-pwa-install title={t.nav.installAppTitle} aria-label={t.nav.installAppTitle}>
      <i data-lucide="download"></i>
      <span>{t.nav.installApp}</span>
    </button>
  </div>
</nav>

<nav class="bottom-nav" aria-label={t.nav.mobileNav}>
  <a class="bottom-nav__link" href={homePath} data-astro-prefetch aria-current={isHome ? "page" : undefined}>
    <i data-lucide="sparkles"></i>
    <span>{t.nav.home}</span>
  </a>
  <a class="bottom-nav__link" href={pokedexPath} data-astro-prefetch aria-current={isPokedex ? "page" : undefined}>
    <i data-lucide="book-open"></i>
    <span>{t.nav.pokedex}</span>
  </a>
  <a class="bottom-nav__link" href={equipoPath} data-astro-prefetch aria-current={isEquipo ? "page" : undefined}>
    <i data-lucide="users"></i>
    <span>{t.nav.team}</span>
  </a>
  <a class="bottom-nav__link" href={blogPath} data-astro-prefetch aria-current={isBlog ? "page" : undefined}>
    <i data-lucide="book"></i>
    <span>{t.nav.blog}</span>
  </a>
</nav>

<script>
  import { isSoundEnabled, setSoundEnabled } from "../lib/sound";
  import { toast } from "../lib/toast";
  import { getCurrentLocale, getTranslations } from "../lib/i18n/translations";
  import { refreshIcons } from "../lib/icons";
  import {
    getCloudState,
    initCloudSyncClient,
    CLOUD_STATUS_EVENT,
    type CloudState,
  } from "../lib/cloudSync";

  function initSoundToggle() {
    const soundBtn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    if (!soundBtn) return;

    const iconOn = soundBtn.querySelector<HTMLElement>("[data-sound-icon-on]");
    const iconOff = soundBtn.querySelector<HTMLElement>("[data-sound-icon-off]");

    function updateIcons(enabled: boolean) {
      if (iconOn) iconOn.hidden = !enabled;
      if (iconOff) iconOff.hidden = enabled;
      soundBtn?.classList.toggle("nav__sound-btn--muted", !enabled);
    }

    updateIcons(isSoundEnabled());

    soundBtn.addEventListener("click", () => {
      const nextState = !isSoundEnabled();
      setSoundEnabled(nextState);
      updateIcons(nextState);
    });
  }

  let deferredPrompt: any = null;

  function isAppInstalled(): boolean {
    const isStandalone = window.matchMedia("(display-mode: standalone)").matches || (navigator as any).standalone === true;
    const isInstalledStorage = localStorage.getItem("pokeforge_installed") === "true";
    return isStandalone || isInstalledStorage;
  }

  function initPwaInstall() {
    const pwaRows = document.querySelectorAll<HTMLElement>("[data-pwa-row]");
    const pwaBtns = document.querySelectorAll<HTMLButtonElement>("[data-pwa-install]");
    if (!pwaRows.length || !pwaBtns.length) return;

    function hideAll() {
      pwaRows.forEach((row) => (row.hidden = true));
    }

    function showAll() {
      pwaRows.forEach((row) => (row.hidden = false));
      refreshIcons();
    }

    if (isAppInstalled()) {
      hideAll();
      return;
    }

    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (!isAppInstalled()) showAll();
    });

    const isIos = /iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase());
    if (isIos && !isAppInstalled()) {
      showAll();
    }

    window.addEventListener("appinstalled", () => {
      localStorage.setItem("pokeforge_installed", "true");
      hideAll();
      const t = getTranslations(getCurrentLocale());
      toast.success(t.nav.installedSuccess);
    });

    pwaBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const t = getTranslations(getCurrentLocale());
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const choice = await deferredPrompt.userChoice;
          if (choice.outcome === "accepted") {
            localStorage.setItem("pokeforge_installed", "true");
            hideAll();
            toast.success(t.nav.installedSuccess);
          }
          deferredPrompt = null;
        } else {
          toast.info(t.nav.pwaHint);
        }
      });
    });
  }

  function initCloudStatus() {
    const cloudBtn = document.querySelector<HTMLButtonElement>("[data-cloud-btn]");
    if (!cloudBtn) return;

    const textEl = cloudBtn.querySelector<HTMLElement>("[data-cloud-text]");
    const stateIcons = cloudBtn.querySelectorAll<HTMLElement>("[data-cloud-state]");

    function updateCloudUI(state: CloudState) {
      const locale = getCurrentLocale();
      const t = getTranslations(locale);
      const status = state.status;

      cloudBtn?.setAttribute("data-status", status);

      stateIcons.forEach((el) => {
        el.hidden = el.dataset.cloudState !== status;
      });

      cloudBtn?.classList.remove(
        "nav__sync-btn--synced",
        "nav__sync-btn--syncing",
        "nav__sync-btn--offline",
        "nav__sync-btn--error",
        "nav__sync-btn--unlinked"
      );
      cloudBtn?.classList.add(`nav__sync-btn--${status}`);

      let label = t.nav.sync;
      let tooltip = t.nav.cloudTooltipUnlinked;

      switch (status) {
        case "synced":
          label = t.nav.cloudSynced;
          tooltip = state.code ? `${t.nav.cloudTooltipSynced} (${state.code})` : t.nav.cloudTooltipSynced;
          break;
        case "syncing":
          label = t.nav.cloudSyncing;
          tooltip = t.nav.cloudTooltipSyncing;
          break;
        case "offline":
          label = t.nav.cloudOffline;
          tooltip = t.nav.cloudTooltipOffline;
          break;
        case "error":
          label = t.nav.cloudError;
          tooltip = state.lastError || t.nav.cloudTooltipError;
          break;
        case "unlinked":
        default:
          label = t.nav.sync;
          tooltip = t.nav.cloudTooltipUnlinked;
          break;
      }

      if (textEl) textEl.textContent = label;
      cloudBtn?.setAttribute("title", tooltip);
      cloudBtn?.setAttribute("aria-label", tooltip);
    }

    initCloudSyncClient();
    updateCloudUI(getCloudState());
    refreshIcons();

    window.addEventListener(CLOUD_STATUS_EVENT, (e) => {
      const detail = (e as CustomEvent<CloudState>).detail;
      if (detail) {
        updateCloudUI(detail);
        refreshIcons();
      }
    });
  }

  initSoundToggle();
  initPwaInstall();
  initCloudStatus();
  document.addEventListener("astro:after-swap", () => {
    initSoundToggle();
    initPwaInstall();
    initCloudStatus();
  });
</script>
