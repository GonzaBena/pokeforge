---
import { getTranslations, type Locale } from "../lib/i18n/translations";
const currentLocale = (Astro.currentLocale ?? "en") as Locale;
const t = getTranslations(currentLocale);
---

<div class="load-more-wrap" data-load-more-wrap hidden>
  <button class="btn btn--primary" type="button" data-load-more>
    {t.pokedex.loadMore}
    <i data-lucide="chevron-down"></i>
  </button>
</div>
